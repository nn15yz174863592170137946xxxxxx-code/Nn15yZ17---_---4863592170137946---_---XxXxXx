local function getPlayerKey() return table.concat(getPlayerList(), "|") end

local function applySpectate()
    if not cam then return end
    if not spectate.name then
        if spectate.appliedName then
            cam.CameraType = spectate.savedType or Enum.CameraType.Custom
            cam.CameraSubject = spectate.savedSubject
            LocalPlayer.CameraMaxZoomDistance = spectate.savedMax
            LocalPlayer.CameraMinZoomDistance = spectate.savedMin
            local sd = spectate.savedDist
            if sd and sd > 0 then
                LocalPlayer.CameraMinZoomDistance = sd
                LocalPlayer.CameraMaxZoomDistance = sd
                task.defer(function()
                    LocalPlayer.CameraMinZoomDistance = spectate.savedMin
                    LocalPlayer.CameraMaxZoomDistance = spectate.savedMax
                end)
            end
            spectate.appliedName = nil
        end
        return
    end
    if spectate.appliedName == spectate.name then return end
    local plr = Players:FindFirstChild(spectate.name)
    local hum = plr and plr.Character and plr.Character:FindFirstChildOfClass("Humanoid")
    if not hum then spectate.name = nil; return end
    if not spectate.appliedName then
        spectate.savedType = cam.CameraType
        spectate.savedSubject = cam.CameraSubject
        spectate.savedMin = LocalPlayer.CameraMinZoomDistance
        spectate.savedMax = LocalPlayer.CameraMaxZoomDistance
        spectate.savedDist = (cam.CFrame.Position - cam.Focus.Position).Magnitude
    end
    cam.CameraType = Enum.CameraType.Custom
    cam.CameraSubject = hum
    LocalPlayer.CameraMaxZoomDistance = math.huge
    LocalPlayer.CameraMinZoomDistance = spectate.distance
    local n = spectate.name
    task.defer(function()
        if spectate.appliedName == n then LocalPlayer.CameraMinZoomDistance = 0 end
    end)
    spectate.appliedName = spectate.name
end

