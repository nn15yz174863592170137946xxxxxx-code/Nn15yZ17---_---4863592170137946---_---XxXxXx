    table.clear(placeAnchors)
end

local function initPlaces()
    if not isMapLoaded() then
        clearAllPlaceAnchors()
        return
    end
    for _, data in ipairs(PLACE_DATA) do
        placeAnchors[data.Name] = makePlaceAnchor(data.Name, data.Pos)
    end
end

local function getPlacesList()
    local list = {}
    for _, p in pairs(placeAnchors) do
        if p and p.Parent then list[#list + 1] = p end
    end
    return list
end

local function cleanupPlaces()
    if placesAnchorFolder and placesAnchorFolder.Parent then
        placesAnchorFolder:Destroy()
    end
    placesAnchorFolder = nil
    table.clear(placeAnchors)
end

