local muzzleVel, projectileDrop, lastWeapon
local function getWeaponData(name)
    local ranged = ReplicatedStorage:FindFirstChild("RangedWeapons")
    local ammoTypes = ReplicatedStorage:FindFirstChild("AmmoTypes")
    if not ranged or not ammoTypes then return nil, 0 end
    local weapon = ranged:FindFirstChild(name)
    if not weapon then return nil, 0 end
    local callSign = weapon:GetAttribute("DefaultAmmoCallSign")
    if not callSign then return nil, 0 end
    for _, ammo in ipairs(ammoTypes:GetChildren()) do
        if ammo:GetAttribute("CallSign") == callSign then
            return ammo:GetAttribute("MuzzleVelocity"), ammo:GetAttribute("ProjectileDrop") or 0
        end
    end
    return nil, 0
end
local function watchCharacter(c)
    if not c then return end
    task.spawn(function()
        local holding = c:WaitForChild("Holding", 5)
        if not holding then return end
        local function update()
            local name = holding.Value and holding.Value.Name
            if name and name ~= lastWeapon then
                lastWeapon = name
                muzzleVel, projectileDrop = getWeaponData(name)
            elseif not name then
                lastWeapon, muzzleVel, projectileDrop = nil, nil, nil
            end
        end
        holding:GetPropertyChangedSignal("Value"):Connect(update)
        update()
    end)
end
