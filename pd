-- ===== velocity ===== --
local velTracker = {}
local function getTargetVelocity(character, root)
    if not character or not root then return Vector3.new() end
    local pv = root.AssemblyLinearVelocity or root.Velocity or Vector3.new()
    if pv.Magnitude > 2 then return pv end
    local now = tick()
    local e = velTracker[character]
    if e and e.pos and e.time then
        local dt = now - e.time
        if dt > 0.001 then
            local raw = (root.Position - e.pos) / dt
            e.vel = e.vel and e.vel:Lerp(raw, 0.6) or raw
        end
    end
    if not e then e = {} end
    e.pos, e.time = root.Position, now
    e.vel = e.vel or Vector3.new()
    velTracker[character] = e
    return e.vel
end

-- ===== ballistics ===== --
local function PredictVec(tpos, tvel, origin, speed, accel, ping)
    local d = tpos - origin
    local horiz = Vector3.new(d.X, 0, d.Z).Magnitude
    local t = horiz / math.max(speed, 1) + (ping * PingMul)
    return tpos + (tvel * t * LeadMul)
end

local function PredDrop(origin, target, speed, accel, ping)
    local g = Vector3.yAxis * (workspace.Gravity - accel * 2)
    local d = target - origin
    local horiz = Vector3.new(d.X, 0, d.Z).Magnitude
    local t = horiz / math.max(speed, 1) + (ping * PingMul)
    return 0.5 * g * t * t
end

