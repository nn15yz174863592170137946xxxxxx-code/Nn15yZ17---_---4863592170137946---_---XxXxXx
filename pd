local function getFolderList(fn, sub)
    local list = {}
    local folder = workspace:FindFirstChild(fn)
    if sub and folder then folder = folder:FindFirstChild(sub) end
    if not folder then return list end
    local function scan(c)
        for _, o in ipairs(c:GetChildren()) do
            if o:IsA("Model") or o:IsA("BasePart") then table.insert(list, o)
            elseif o:IsA("Folder") then scan(o) end
        end
    end
    scan(folder)
    return list
end

