end

local function makePlaceAnchor(name, pos)
    local folder = getPlacesAnchorFolder()
    local existing = folder:FindFirstChild(name)
    local targetPos = pos + Vector3.new(0, PLACE_Y_OFFSET, 0)
    if existing then
        existing.Position = targetPos
        return existing
    end
    local part = Instance.new("Part")
    part.Name = name
    part.Anchored = true
    part.CanCollide = false
    part.Transparency = 1
    part.Size = Vector3.new(1, 1, 1)
    part.Position = targetPos
    part.Parent = folder
    return part
end

local function resolvePlace(path)
    local current = workspace
    for _, name in ipairs(path) do
        if not current then return nil end
        current = current:FindFirstChild(name)
    end
    if current and (current:IsA("Model") or current:IsA("BasePart")) then return current end
    return nil
end

local function getModelCenter(model)
    if not model then return nil end
    if model:IsA("BasePart") then return model.Position end
    if model.PrimaryPart then return model.PrimaryPart.Position end
    local part = model:FindFirstChildWhichIsA("BasePart")
    if part then return part.Position end
    local ok, cf = pcall(function() return model:GetBoundingBox() end)
    if ok and cf then return cf.Position end
    return nil
end

local function initPlaces()
    local zones = workspace:FindFirstChild("NoCollision")
    zones = zones and zones:FindFirstChild("AiZones")
    if not zones or #zones:GetChildren() == 0 then
        if placesAnchorFolder and placesAnchorFolder.Parent then
            placesAnchorFolder:Destroy()
        end
        placesAnchorFolder = nil
        table.clear(placeAnchors)
        return
    end
    for _, data in ipairs(PLACE_DATA) do
        local real = resolvePlace(data.Path)
        local basePos = (real and getModelCenter(real)) or data.Pos
        placeAnchors[data.Name] = makePlaceAnchor(data.Name, basePos)
    end
end

local function getPlacesList()
    local zones = workspace:FindFirstChild("NoCollision")
    zones = zones and zones:FindFirstChild("AiZones")
    if not zones or #zones:GetChildren() == 0 then
        return {}
    end
    local list = {}
    for _, p in pairs(placeAnchors) do
        if p and p.Parent then list[#list + 1] = p end
    end
    return list
end

local function cleanupPlaces()
    if placesAnchorFolder and placesAnchorFolder.Parent then
        placesAnchorFolder:Destroy()
    end
    placesAnchorFolder = nil
    table.clear(placeAnchors)
end

initPlaces()
