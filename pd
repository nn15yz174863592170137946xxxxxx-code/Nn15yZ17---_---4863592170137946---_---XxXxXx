-- ===== foliage ===== --
local FS = { NoGrass = false, NoBushes = false, NoFerns = false, NoLeafs = false }
local foliageCache, foliageHook = {}, nil
local function nameMatch(part, kw, root)
    local c = part
    while c and c ~= root do
        if c.Name:lower():find(kw, 1, true) then return true end
        c = c.Parent
    end
    return false
end
local function hasSurf(part)
    for _, c in ipairs(part:GetChildren()) do if c:IsA("SurfaceAppearance") then return true end end
    return false
end
local function getFoliage()
    local sz = workspace:FindFirstChild("SpawnerZones")
    return sz and sz:FindFirstChild("Foliage")
end
local function shouldHide(part, root)
    if not part:IsA("BasePart") then return false end
    if FS.NoBushes and nameMatch(part, "bush", root) then return true end
    if FS.NoFerns and nameMatch(part, "fern", root) then return true end
    if FS.NoLeafs and nameMatch(part, "tree", root) and hasSurf(part) then return true end
    return false
end
local function applyFoliage()
    local foliage = getFoliage()
    if not foliage then return end
    for _, part in ipairs(foliage:GetDescendants()) do
        if shouldHide(part, foliage) then
            if not foliageCache[part] then foliageCache[part] = part.Transparency end
            part.Transparency = 1
        elseif foliageCache[part] then
            part.Transparency = foliageCache[part]
            foliageCache[part] = nil
        end
    end
end
local function attachFoliage()
    if foliageHook then foliageHook:Disconnect(); foliageHook = nil end
    local foliage = getFoliage()
    if not foliage then return end
    foliageHook = foliage.DescendantAdded:Connect(function(part)
        task.defer(function()
            if part.Parent and shouldHide(part, foliage) then
                if not foliageCache[part] then foliageCache[part] = part.Transparency end
                part.Transparency = 1
            end
        end)
    end)
end
local function refreshFoliage()
    applyFoliage()
    if FS.NoBushes or FS.NoFerns or FS.NoLeafs then attachFoliage()
    elseif foliageHook then foliageHook:Disconnect(); foliageHook = nil end
end
