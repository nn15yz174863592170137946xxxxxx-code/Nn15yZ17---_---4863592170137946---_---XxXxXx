local function collectEntities()
    local list = {}
    local seen = {}
    local function add(m)
        if not m or seen[m] then return end
        seen[m] = true
        list[#list + 1] = m
    end

    if aim.TargetPlayers then
        for _, plr in ipairs(Players:GetPlayers()) do
            if plr ~= LocalPlayer
                and not (aim.Whitelist and table.find(aim.Whitelist, plr.Name))
                and not aim:IsSameTeam(plr) then
                add(plr.Character)
            end
        end
    end

    for _, src in pairs(aim.TargetSources) do
        if src.Enabled then
            local getter = src.GetEntities or src.Getter
            if getter then
                local ok, ents = pcall(getter)
                if ok and ents then
                    for _, ent in ipairs(ents) do
                        local m = ent
                        if typeof(ent) == "Instance" and ent:IsA("Player") then m = ent.Character end
                        if typeof(m) == "Instance" and m:IsA("Model") then add(m) end
                    end
                end
            end
        end
    end

    return list
end

local function findBestTarget()
    if not localChar then return nil end
    local camPos = cam.CFrame.Position
    local fPos = Vector2.new(cam.ViewportSize.X/2, cam.ViewportSize.Y/2)
    local maxDist = (tonumber(aim.FOVSize) or 500) / 2
    local best, bestScore = nil, math.huge

    local tlist = aim.Targetlist
    if aim.TargetPlayers and tlist and #tlist > 0 then
        for _, plr in ipairs(Players:GetPlayers()) do
            if plr ~= LocalPlayer and table.find(tlist, plr.Name)
                and not (aim.Whitelist and table.find(aim.Whitelist, plr.Name))
                and not aim:IsSameTeam(plr) then
                local c = plr.Character
                if c then
                    local d = aim:GetScreenDistance(c, camPos, fPos, maxDist)
                    if d and d < bestScore then bestScore = d; best = c end
                end
            end
        end
        if best then return best end
    end

    for _, m in ipairs(collectEntities()) do
        local d = aim:GetScreenDistance(m, camPos, fPos, maxDist)
        if d and d < bestScore then bestScore = d; best = m end
    end

    return best
end

local function ComputeAim()
    if not localChar or not localChar.Parent then return nil end
    if not localChar:FindFirstChild("HumanoidRootPart") then return nil end
    local target = findBestTarget()
    if not target then return nil end
    local camPos = cam.CFrame.Position
    local aimPoint, aimPart
    for _, part in ipairs(aim:GetAimParts(target)) do
        local p = aim:GetClosestVisiblePoint(part, target, camPos, localChar)
        if p then aimPoint = p; aimPart = part; break end
    end
    if not aimPoint then return nil end

    local finalTarget = aimPoint
    if Prediction.Enabled then
        local accel = projectileDrop or 0
        local speed = muzzleVel or 0
        if speed > 0 then
            local ping = LocalPlayer:GetNetworkPing()
            local vel = getTargetVelocity(target, aimPart)
            local tpos = PredictVec(aimPoint, vel, camPos, speed, accel, ping)
            local dropVec = PredDrop(camPos, tpos, speed, accel, ping)
            finalTarget = tpos + dropVec
        end
    end

    return finalTarget, camPos
end

local function ComputeAimNoFOV()
    local saved = aim.FOVSize
    aim.FOVSize = 999999
    local t, p = ComputeAim()
    aim.FOVSize = saved
    return t, p
end

