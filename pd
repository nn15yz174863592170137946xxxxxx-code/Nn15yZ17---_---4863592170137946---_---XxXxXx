-- ===== velocity ===== --
local velTracker = {}
local function getTargetVelocity(character, root)
    if not character or not root then return Vector3.new() end
    local pv = root.AssemblyLinearVelocity or root.Velocity or Vector3.new()
    if pv.Magnitude > 2 then return pv end
    local now = tick()
    local e = velTracker[character]
    if e and e.pos and e.time then
        local dt = now - e.time
        if dt > 0.001 then
            local raw = (root.Position - e.pos) / dt
            e.vel = e.vel and e.vel:Lerp(raw, 0.6) or raw
        end
    end
    if not e then e = {} end
    e.pos, e.time = root.Position, now
    e.vel = e.vel or Vector3.new()
    velTracker[character] = e
    return e.vel
end

-- ===== ballistics ===== --
local function SolveQuad(a, b, c)
    local d = b * b - 4 * a * c
    if d < 0 then return nil end
    local r = math.sqrt(d)
    return (-b - r) / (2 * a), (-b + r) / (2 * a)
end
local function FlightTime(dir, grav, speed)
    local r1, r2 = SolveQuad(grav:Dot(grav) / 4, grav:Dot(dir) - speed * speed, dir:Dot(dir))
    if r1 and r2 then
        if r1 > 0 and r1 < r2 then return math.sqrt(r1)
        elseif r2 > 0 and r2 < r1 then return math.sqrt(r2) end
    end
    return 0
end
local function PredictVec(tpos, tvel, origin, speed, accel, ping)
    local g = Vector3.yAxis * (accel * 2)
    local t = FlightTime(tpos - origin, g, speed) + (ping * PingMul)
    return tpos + (tvel * t * LeadMul)
end
local function PredDrop(origin, target, speed, accel, ping)
    local g = Vector3.yAxis * (accel * 2)
    local t = FlightTime(target - origin, g, speed) + (ping * PingMul)
    return 0.5 * g * t * t * DropMul
end

