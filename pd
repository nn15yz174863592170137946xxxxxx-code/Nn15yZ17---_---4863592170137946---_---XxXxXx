local PLACE_Y_OFFSET = 100
local placeAnchors = {}
local placesAnchorFolder = nil

local function getPlacesAnchorFolder()
    if placesAnchorFolder and placesAnchorFolder.Parent then return placesAnchorFolder end
    placesAnchorFolder = workspace:FindFirstChild("PlacesESP_Anchors")
    if not placesAnchorFolder then
        placesAnchorFolder = Instance.new("Folder")
        placesAnchorFolder.Name = "PlacesESP_Anchors"
        placesAnchorFolder.Parent = workspace
    end
    return placesAnchorFolder
end

local function makePlaceAnchor(name, pos)
    local folder = getPlacesAnchorFolder()
    local existing = folder:FindFirstChild(name)
    local targetPos = pos + Vector3.new(0, PLACE_Y_OFFSET, 0)
    if existing then
        existing.Position = targetPos
        return existing
    end
    local part = Instance.new("Part")
    part.Name = name
    part.Anchored = true
    part.CanCollide = false
    part.Transparency = 1
    part.Size = Vector3.new(1, 1, 1)
    part.Position = targetPos
    part.Parent = folder
    return part
end

