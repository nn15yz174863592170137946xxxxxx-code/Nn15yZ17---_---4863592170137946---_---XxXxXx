-- ===== ammo mods ===== --
local RecoilAttrs = {"RecoilStrength","Recoil","RecoilX","RecoilY","VerticalRecoil","HorizontalRecoil","CameraRecoil","ViewmodelRecoil","Kick","KickStrength","RecoilMultiplier","RecoilScale"}
local AmmoCache = {}

local function cacheAttr(ammo, name)
    if not ammo then return end
    if not AmmoCache[ammo] then AmmoCache[ammo] = {} end
    if AmmoCache[ammo][name] == nil then
        local v = ammo:GetAttribute(name)
        if v ~= nil then AmmoCache[ammo][name] = v end
    end
end
local function SetAttrs(ammo, names, value)
    if not ammo then return end
    for _, n in ipairs(names) do
        cacheAttr(ammo, n)
        pcall(function() if ammo:GetAttribute(n) ~= nil then ammo:SetAttribute(n, value) end end)
    end
end
local function ZeroRecoilTable(t, d)
    if d > 5 then return end
    for k, v in pairs(t) do
        local tv = typeof(v)
        if tv == "number" then t[k] = 0
        elseif tv == "Vector2" or tv == "Vector3" then t[k] = v * 0
        elseif tv == "CFrame" then t[k] = CFrame.new()
        elseif tv == "table" then ZeroRecoilTable(v, d + 1) end
    end
end
local function ApplyRecoil()
    if not Misc.NoRecoil then return end
    local f = ReplicatedStorage:FindFirstChild("AmmoTypes")
    if not f then return end
    for _, a in ipairs(f:GetChildren()) do SetAttrs(a, RecoilAttrs, 0) end
end
local function RestoreAmmo()
    for a, attrs in pairs(AmmoCache) do
        if a.Parent then
            for n, v in pairs(attrs) do pcall(function() a:SetAttribute(n, v) end) end
        end
    end
    table.clear(AmmoCache)
end

-- ===== silent aim hook ===== --
local function InitSilentAim()
    if SilentHook.Hooked then return end
    task.spawn(function()
        while not SilentHook.Hooked do
            for _, v in pairs(getgc(true)) do
                if type(v) == "table" and type(rawget(v, "CreateBullet")) == "function" then
                    SilentHook.Table = v
                    SilentHook.Orig = rawget(v, "CreateBullet")
                    rawset(v, "CreateBullet", function(idk, m1, m2, m3, aimPart, idk2, ammoType, t, recoilPattern)
                        local f = ReplicatedStorage:FindFirstChild("AmmoTypes")
                        local ammo = f and ammoType and f:FindFirstChild(ammoType)

                        if Misc.NoRecoil then
                            if type(recoilPattern) == "table" then
                                ZeroRecoilTable(recoilPattern, 0)
                            else
                                recoilPattern = {0, 0, 0, 0}
                            end
                            SetAttrs(ammo, RecoilAttrs, 0)
                        end

                        local finalAim = aimPart
                        if SilentAim.Enabled then
                            local origin = GetAimOrigin(aimPart)
                            if origin then
                                local target = ComputeAimNoFOV()
                                if target then
                                    finalAim = { CFrame = CFrame.new(origin, target) }
                                end
                            end
                        end

                        return SilentHook.Orig(idk, m1, m2, m3, finalAim, idk2, ammoType, t, recoilPattern)
                    end)
                    SilentHook.Hooked = true
                    return
                end
            end
            task.wait(1)
        end
    end)
end

