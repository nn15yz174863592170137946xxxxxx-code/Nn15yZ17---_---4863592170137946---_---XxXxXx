-- ===== scheduler ===== --
local Scheduler = { tasks = {} }
function Scheduler:Every(name, interval, fn)
    self.tasks[name] = { interval = interval, acc = interval, fn = fn }
end
function Scheduler:Step(dt)
    for _, t in pairs(self.tasks) do
        t.acc = t.acc + dt
        if t.acc >= t.interval then t.acc = 0; pcall(t.fn) end
    end
end
RunService.Heartbeat:Connect(function(dt) Scheduler:Step(dt) end)

