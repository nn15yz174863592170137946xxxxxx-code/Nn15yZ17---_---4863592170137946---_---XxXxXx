local playerBillboards = {}
local mobBillboards = {}

local function createBillboard(parentPart, color)
    local billboard = Instance.new("BillboardGui")
    billboard.Adornee = parentPart
    billboard.Size = UDim2.new(0, 100, 0, 150)
    billboard.StudsOffset = Vector3.new(0, 1, 0)
    billboard.AlwaysOnTop = true
    billboard.Parent = COREGUI

    local label = Instance.new("TextLabel")
    label.BackgroundTransparency = 1
    label.Position = UDim2.new(0, 0, 0, -50)
    label.Size = UDim2.new(0, 100, 0, 100)
    label.Font = Enum.Font.SourceSansSemibold
    label.TextSize = 20
    label.TextColor3 = color
    label.TextStrokeTransparency = 0
    label.TextYAlignment = Enum.TextYAlignment.Bottom
    label.ZIndex = 10
    label.Parent = billboard

    return billboard, label
end

local function updatePlayerBillboards()
    for plr, data in pairs(playerBillboards) do
        if not plr.Parent or not plr.Character then
            data.billboard:Destroy()
            playerBillboards[plr] = nil
        end
    end

    for _, plr in ipairs(Players:GetPlayers()) do
        if plr == LocalPlayer then continue end
        local char = plr.Character
        if not char then
            if playerBillboards[plr] then
                playerBillboards[plr].billboard:Destroy()
                playerBillboards[plr] = nil
            end
            continue
        end

        local head = char:FindFirstChild("Head")
        local hum = char:FindFirstChildOfClass("Humanoid")
        if not head or not hum or hum.Health <= 0 then
            if playerBillboards[plr] then
                playerBillboards[plr].billboard:Destroy()
                playerBillboards[plr] = nil
            end
            continue
        end

        if not playerBillboards[plr] then
            local billboard, label = createBillboard(head, Color3.new(1, 1, 1))
            playerBillboards[plr] = {billboard = billboard, label = label}
        end

        local data = playerBillboards[plr]
        local dist = getRoot(LocalPlayer.Character) and getRoot(char) and math.floor((getRoot(LocalPlayer.Character).Position - getRoot(char).Position).Magnitude) or 0
        local health = round(hum.Health, 1)
        data.label.Text = "Name: " .. plr.Name .. " | Health: " .. health .. " | Studs: " .. dist
        data.billboard.Adornee = head
    end
end

local function updateMobBillboards()
    for mob, data in pairs(mobBillboards) do
        if not mob.Parent or not mob:FindFirstChildOfClass("Humanoid") or mob:FindFirstChildOfClass("Humanoid").Health <= 0 then
            data.billboard:Destroy()
            mobBillboards[mob] = nil
        end
    end

    local mobsFolder = workspace:FindFirstChild("Mobs")
    if mobsFolder then
        for _, mob in ipairs(mobsFolder:GetChildren()) do
            if not mob:IsA("Model") then continue end
            local hum = mob:FindFirstChildOfClass("Humanoid")
            if not hum or hum.Health <= 0 then continue end
            local head = mob:FindFirstChild("Head") or mob:FindFirstChild("HumanoidRootPart") or mob:FindFirstChildWhichIsA("BasePart")
            if not head then continue end

            if not mobBillboards[mob] then
                local billboard, label = createBillboard(head, Color3.new(1, 0, 0))
                mobBillboards[mob] = {billboard = billboard, label = label}
            end

            local data = mobBillboards[mob]
            local dist = getRoot(LocalPlayer.Character) and math.floor((getRoot(LocalPlayer.Character).Position - head.Position).Magnitude) or 0
            local health = round(hum.Health, 1)
            data.label.Text = "Name: " .. mob.Name .. " | Health: " .. health .. " | Studs: " .. dist
            data.billboard.Adornee = head
        end
    end
end

local espLoop = nil
local function startESPLoop()
    if espLoop then return end
    espLoop = RunService.RenderStepped:Connect(function()
        if espPlayersEnabled then
            updatePlayerBillboards()
        else
            for _, data in pairs(playerBillboards) do
                data.billboard:Destroy()
            end
            table.clear(playerBillboards)
        end

        if espMobsEnabled then
            updateMobBillboards()
        else
            for _, data in pairs(mobBillboards) do
                data.billboard:Destroy()
            end
            table.clear(mobBillboards)
        end
    end)
end

local function stopESPLoop()
    if espLoop then
        espLoop:Disconnect()
        espLoop = nil
    end
    for _, data in pairs(playerBillboards) do data.billboard:Destroy() end
    table.clear(playerBillboards)
    for _, data in pairs(mobBillboards) do data.billboard:Destroy() end
    table.clear(mobBillboards)
end

Toggles.ESPPlayers:OnChanged(function(v)
    if v then
        startESPLoop()
    else
        if not espMobsEnabled then
            stopESPLoop()
        end
    end
end)

Toggles.ESPMobs:OnChanged(function(v)
    if v then
        startESPLoop()
    else
        if not espPlayersEnabled then
            stopESPLoop()
        end
    end
end)

Players.PlayerRemoving:Connect(function(plr)
    if playerBillboards[plr] then
        playerBillboards[plr].billboard:Destroy()
        playerBillboards[plr] = nil
    end
end)

startESPLoop()

