-- ===== SAFETY CHECK ===== --
local function isUnsafe(pos)
    if workspace:FindFirstChild("Live") then
        for _,p in ipairs(workspace.Live:GetChildren()) do
            local hrp = p:FindFirstChild("HumanoidRootPart")
            if hrp and (hrp.Position - pos).Magnitude <= SAFE_RADIUS then
                return true
            end
        end
    end

    if workspace:FindFirstChild("Mobs") then
        for _,m in ipairs(workspace.Mobs:GetChildren()) do
            local part = m:FindFirstChild("HumanoidRootPart") or m:FindFirstChildWhichIsA("BasePart")
            if part and (part.Position - pos).Magnitude <= SAFE_RADIUS then
                return true
            end
        end
    end

    return false
end

-- ===== AUTOFARM LOGIC ===== --
local LOOK_DOWN = CFrame.Angles(math.rad(-90),0,0)

local function isStorageValid(storage)
    if not storage or not storage.Parent then return false end
    if storage:FindFirstChild("Contents") then return false end
    local door = storage:FindFirstChild("Door")
    if door and door:FindFirstChild("Lock") then return false end
    if door and door:FindFirstChild("Handle") then
        return not isUnsafe(door.Handle.Position)
    end
    return false
end

local function processStorage(storage, startCF)
    local function waitForAliveChar()
        local char = LocalPlayer.Character
        while not char or not char:FindFirstChild("HumanoidRootPart")
            or not char:FindFirstChildOfClass("Humanoid")
            or char:FindFirstChildOfClass("Humanoid").Health <= 0 do
            LocalPlayer.CharacterAdded:Wait()
            char = LocalPlayer.Character
        end
        return char
    end

    local char = waitForAliveChar()
    local hrp = char:WaitForChild("HumanoidRootPart")

    local door = storage:FindFirstChild("Door")
    if not door or not door:FindFirstChild("Handle") then return false end
    local handle = door.Handle

    hrp.CFrame = handle.CFrame * CFrame.new(0,2.5,-1.5)
    task.wait(0.1)
    cam.CFrame = CFrame.new(cam.CFrame.Position, handle.Position)
    task.wait(0.1)

    for i = 1, 10 do
        for _,pp in ipairs(handle:GetDescendants()) do
            if pp:IsA("ProximityPrompt") then
                pp.HoldDuration = 0
                fireproximityprompt(pp)
            end
        end
        task.wait()
    end

    local contents
    local t = os.clock()
    while os.clock() - t < 1 do
        contents = storage:FindFirstChild("Contents")
        if contents then break end
        task.wait()
    end
    if not contents then
        if startCF then hrp.CFrame = startCF end
        return true  -- no loot, consider done
    end

    local loot = contents:FindFirstChild("Loot")
    if not loot then
        if startCF then hrp.CFrame = startCF end
        return true
    end

    while #loot:GetChildren() > 0 do
        for _, item in ipairs(loot:GetChildren()) do
            if not char or not char:FindFirstChild("HumanoidRootPart")
                or not char:FindFirstChildOfClass("Humanoid")
                or char:FindFirstChildOfClass("Humanoid").Health <= 0 then
                return false
            end

            local pos
            if item:IsA("BasePart") then
                pos = item.Position
            elseif item:IsA("Model") then
                local p = item:FindFirstChildWhichIsA("BasePart")
                if p then pos = p.Position end
            elseif item:IsA("Attachment") then
                pos = item.WorldPosition
            end

            if pos then
                hrp.CFrame = CFrame.new(pos + Vector3.new(0,2.5,0))
                task.wait(0.05)
                cam.CFrame = CFrame.new(cam.CFrame.Position) * LOOK_DOWN
                task.wait(0.05)
                for _,pp in ipairs(item:GetDescendants()) do
                    if pp:IsA("ProximityPrompt") then
                        pp.HoldDuration = 0
                        fireproximityprompt(pp)
                    end
                end
            end
        end
        task.wait()
    end

    if startCF then
        hrp.CFrame = startCF
    end

    return true
end

