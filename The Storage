-- ===== aimlock loop ===== --
local function offsetLookAt(camPos, targetPos)
    local lookAt = CFrame.lookAt(camPos, targetPos)
    local fovRad = math.rad(cam.FieldOfView)
    local screenHeight = cam.ViewportSize.Y
    local anglePerPixel = fovRad / screenHeight
    local pitchOffset = 25 * anglePerPixel
    return lookAt * CFrame.Angles(-pitchOffset, 0, 0)
end

local function getPredictedPos(part)
    local vel = part.Velocity
    return part.Position + Vector3.new(
        vel.X * 0.25,
        vel.Y * 0.025,
        vel.Z * 0.25
    )
end

task.spawn(function()
    while task.wait(0.03) do
        if not aimEnabled then continue end
        local char = LocalPlayer.Character
        if not char then continue end
        local hrp = char:FindFirstChild("HumanoidRootPart")
        if not hrp then continue end

        local camPos = cam.CFrame.Position
        local bestTarget = nil
        local bestDist = math.huge
        local priorityTarget = nil

        local function isVisible(part)
            local dir = (part.Position - camPos).Unit
            local dist = (part.Position - camPos).Magnitude
            local ray = Ray.new(camPos, dir * dist)
            local hit = workspace:FindPartOnRayWithIgnoreList(ray, {char}, false, true)
            if not hit then return false end
            local character = part
            while character and not character:IsA("Model") do
                character = character.Parent
            end
            return character and hit:IsDescendantOf(character)
        end

        local function getAimPart(entity)
            local part = entity:FindFirstChild("Head")
            if not part then part = entity:FindFirstChild("HumanoidRootPart") end
            if not part then part = entity:FindFirstChildWhichIsA("BasePart") end
            return part
        end

        local function evaluateTarget(aimPart, isPlayer)
            if not aimPart then return nil, nil end
            local predictedPos = getPredictedPos(aimPart)
            local screenPos, onScreen = cam:WorldToViewportPoint(predictedPos)
            if not onScreen then return nil, nil end
            local fPos = Vector2.new(cam.ViewportSize.X/2, cam.ViewportSize.Y/2 - 25)
            local dx = screenPos.X - fPos.X
            local dy = screenPos.Y - fPos.Y
            local screenDist = math.sqrt(dx*dx + dy*dy)
            if screenDist <= fovSize/2 and isVisible(aimPart) then
                return aimPart, screenDist, predictedPos
            end
            return nil, nil
        end

        if targetPlayers and targetPlayer and targetPlayer.Character then
            local character = targetPlayer.Character
            local humanoid = character:FindFirstChild("Humanoid")
            if humanoid and humanoid.Health > 0 and not table.find(WhitelistPlayers, targetPlayer.Name) then
                local hasShield = character:FindFirstChild("PvPShield") ~= nil
                if not hasShield then
                    local aimPart = getAimPart(character)
                    if aimPart then
                        local _, dist, predictedPos = evaluateTarget(aimPart, true)
                        if dist then
                            priorityTarget = predictedPos
                            bestDist = dist
                        end
                    end
                end
            end
        end

        if priorityTarget then
            cam.CFrame = offsetLookAt(camPos, priorityTarget)
            continue
        end

        if targetPlayers then
            for _, plr in ipairs(Players:GetPlayers()) do
                if plr == LocalPlayer then continue end
                if table.find(WhitelistPlayers, plr.Name) then continue end
                local character = plr.Character
                if not character then continue end
                local humanoid = character:FindFirstChild("Humanoid")
                if not humanoid or humanoid.Health <= 0 then continue end
                local hasShield = character:FindFirstChild("PvPShield") ~= nil
                if hasShield then continue end

                local aimPart = getAimPart(character)
                if aimPart then
                    local _, dist, predictedPos = evaluateTarget(aimPart, true)
                    if predictedPos and dist < bestDist then
                        bestTarget = predictedPos
                        bestDist = dist
                    end
                end
            end
        end

        if targetMobs and workspace:FindFirstChild("Mobs") then
            for _, mob in ipairs(workspace.Mobs:GetChildren()) do
                if mob:IsA("Model") then
                    local humanoid = mob:FindFirstChild("Humanoid")
                    if humanoid and humanoid.Health > 0 then
                        local aimPart = getAimPart(mob)
                        if aimPart then
                            local _, dist, predictedPos = evaluateTarget(aimPart, false)
                            if predictedPos and dist < bestDist then
                                bestTarget = predictedPos
                                bestDist = dist
                            end
                        end
                    end
                end
            end
        end

        if bestTarget then
            cam.CFrame = offsetLookAt(camPos, bestTarget)
        end
    end
end)

