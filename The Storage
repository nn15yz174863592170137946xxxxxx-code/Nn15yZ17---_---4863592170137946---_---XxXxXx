local function applyWalkSpeed(hum)
    if hum then
        hum.WalkSpeed = walkSpeedValue
    end
end

local function disconnectWalkSpeed()
    if walkSpeedSignal then
        walkSpeedSignal:Disconnect()
        walkSpeedSignal = nil
    end
    if walkSpeedCharAdded then
        walkSpeedCharAdded:Disconnect()
        walkSpeedCharAdded = nil
    end
end

local function enableWalkSpeed()
    disconnectWalkSpeed()
    local char = LocalPlayer.Character
    if char then
        local hum = char:FindFirstChild("Humanoid")
        if hum then
            applyWalkSpeed(hum)
            walkSpeedSignal = hum:GetPropertyChangedSignal("WalkSpeed"):Connect(function()
                applyWalkSpeed(hum)
            end)
        end
    end
    walkSpeedCharAdded = LocalPlayer.CharacterAdded:Connect(function(newChar)
        local hum = newChar:FindFirstChild("Humanoid") or newChar:WaitForChild("Humanoid", 5)
        if hum then
            applyWalkSpeed(hum)
            walkSpeedSignal = hum:GetPropertyChangedSignal("WalkSpeed"):Connect(function()
                applyWalkSpeed(hum)
            end)
        end
    end)
end

