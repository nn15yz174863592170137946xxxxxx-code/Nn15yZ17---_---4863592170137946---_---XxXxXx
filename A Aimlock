-- ===== SECTIONS ===== --
local SECTIONS = {
    Enabled = {
        {"EnabledToggle"},
        {"LockAnywhere"},
        {"TeamCheck"},
        {"MaxDistance"},
    },
    Sources = {
        {"SourceCheckbox"},
    },
    FOV = {
        {"FOVSize"},
        {"CrossOffsetX"},
        {"CrossOffsetY"},
        {"FOVRainbowEnabled"},
        {"CrosshairRainbowEnabled"},
    },
    Prediction = {
        {"PredictionXZ"},
        {"PredictionY"},
        {"AutoPredictionEnabled"},
    },
    Targeting = {
        {"SampleMode"},
        {"AimPartPreference"},
        {"HeadChance"},
    },
    Lists = {
        {"Whitelist"},
        {"PriorityTarget"},
    },
}

local SECTION_ORDER = {
    "Enabled",
    "Sources",
    "FOV",
    "Prediction",
    "Targeting",
    "Lists",
}

-- ===== BUILD ===== --
local function Build(Group, prefix, aim, config)
    config = config or {}
    local features = merge(DEFAULT_FEATURES, config.Features)

    local exclude = {}
    for _, id in ipairs(config.Exclude or {}) do
        exclude[id] = true
    end

    local sectionsBuilt = 0

    for _, sectionName in ipairs(SECTION_ORDER) do
        if features[sectionName] ~= false then
            local toRun = {}

            for _, entry in ipairs(SECTIONS[sectionName]) do
                local id = entry[1]
                if not exclude[id] then
                    table.insert(toRun, id)
                end
            end

            if #toRun > 0 then
                if sectionsBuilt > 0 then
                    Group:AddDivider()
                end
                for _, id in ipairs(toRun) do
                    if B[id] then B[id](Group, prefix, aim) end
                end
                sectionsBuilt = sectionsBuilt + 1
            end
        end
    end
end

-- ===== PLAYER LIST REFRESH ===== --
local function SetupPlayerListRefresh(Players, prefix, aim)
    local function collect()
        local names = {}
        for _, plr in ipairs(Players:GetPlayers()) do
            if plr ~= Players.LocalPlayer then
                table.insert(names, plr.Name)
            end
        end
        return names
    end

    task.spawn(function()
        local lastCount = -1
        while true do
            task.wait(1)
            local names = collect()
            if #names ~= lastCount then
                lastCount = #names
                if Options[prefix.."Whitelist"] then
                    Options[prefix.."Whitelist"]:SetValues(names)
                end
                if Options[prefix.."PriorityTarget"] then
                    Options[prefix.."PriorityTarget"]:SetValues(names)
                end
            end
        end
    end)

    if Options[prefix.."Whitelist"] then
        Options[prefix.."Whitelist"]:SetValues(collect())
    end
    if Options[prefix.."PriorityTarget"] then
        Options[prefix.."PriorityTarget"]:SetValues(collect())
    end
end

-- ===== FACTORY ===== --
local function Create(Group, prefix, Players, LocalPlayer, Camera, config, sources)
    config = config or {}

    local settings = merge(DEFAULTS, config.Settings)
    local aim = Aimlock.new(Players, LocalPlayer, Camera, settings)
    aim:CreateFOV()

    if sources then
        for _, src in ipairs(sources) do
            aim:AddTargetSource(src.Name, src.Getter, src.Enabled ~= false)
        end
    end

    Build(Group, prefix, aim, config)
    SetupPlayerListRefresh(Players, prefix, aim)

    return aim
end

