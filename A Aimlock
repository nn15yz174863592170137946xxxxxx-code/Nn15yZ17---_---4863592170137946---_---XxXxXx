-- ===== SECTIONS ===== --
local SECTIONS = {
    Enabled = {
        {"EnabledToggle"}, {"LockAnywhere"}, {"TeamCheck"}, {"WallCheck"},
        {"MaxDistance"}, {"UpdateRate"}, {"MobileQuickToggle"},
        {"MobileWallCheckToggle"}, {"Keybind"}, {"WallCheckKeybind"},
    },
    Target = {
        {"TargetPlayers"}, {"TargetCustom"},
    },
    Lists = {
        {"Whitelist"}, {"PriorityTarget"},
    },
    Prediction = {
        {"PredictionXZ"}, {"PredictionY"}, {"AutoPrediction"},
    },
    Targeting = {
        {"SampleMode"}, {"AimPart"}, {"HeadChance"},
    },
    FOV = {
        {"FOVSize"}, {"CrossOffsetX"}, {"CrossOffsetY"},
        {"FOVRainbowEnabled"}, {"CrosshairRainbowEnabled"}, {"RainbowSpeed"},
    },
}

local SECTION_ORDER = {"Enabled", "Target", "Lists", "Prediction", "Targeting", "FOV"}

-- ===== BUILD ===== --
local function Build(Group, prefix, aim, config)
    config = config or {}
    local features = merge(DEFAULT_FEATURES, config.Features)
    local exclude = {}
    for _, id in ipairs(config.Exclude or {}) do exclude[id] = true end

    local sectionsBuilt = 0
    for _, sectionName in ipairs(SECTION_ORDER) do
        if features[sectionName] ~= false then
            local toRun = {}
            for _, entry in ipairs(SECTIONS[sectionName]) do
                local id = entry[1]
                if not exclude[id] then toRun[#toRun + 1] = id end
            end
            if #toRun > 0 then
                if sectionsBuilt > 0 then Group:AddDivider() end
                for _, id in ipairs(toRun) do
                    if B[id] then B[id](Group, prefix, aim) end
                end
                sectionsBuilt = sectionsBuilt + 1
            end
        end
    end
end

-- ===== LIVE PLAYER LIST REFRESH (single shared loop) ===== --
local function setupLivePlayerRefresh(aim)
    if not aim._uiWhitelist then return end
    task.spawn(function()
        local lastKey = ""
        while true do
            task.wait()
            local names = buildSortedPlayerList(aim.Players, aim.LocalPlayer)
            local key = table.concat(names, "|")
            if key ~= lastKey then
                lastKey = key
                pcall(function() aim._uiWhitelist:SetValues(names) end)
                if aim._uiPriorityTarget then
                    pcall(function() aim._uiPriorityTarget:SetValues(names) end)
                end
            end
        end
    end)
end

-- ===== STATE SYNC ===== --
local function setupStateSync(aim)
    aim.OnStateChanged = function(state)
        local uiToggle = aim._uiToggle
        if uiToggle and uiToggle.Value ~= state then
            uiToggle:SetValue(state)
        end
    end
end

local function setupWallCheckSync(aim)
    aim.OnWallCheckChanged = function(state)
        local cb = aim._wallCheckToggle
        if cb and cb.Value ~= state then
            cb:SetValue(state)
        end
    end
end

-- ===== FACTORY ===== --
local function Create(Group, prefix, Players, LocalPlayer, Camera, config, sources)
    config = config or {}
    local settings = merge(DEFAULTS, config.Settings)
    local aim = Aimlock.new(Players, LocalPlayer, Camera, settings)

    if sources then
        for _, src in ipairs(sources) do
            aim:AddTargetSource(src.Name, src.Getter, src.Enabled ~= false)
        end
    end

    aim:CreateFOV()
    setupStateSync(aim)
    setupWallCheckSync(aim)

    if aim.MobileButtonEnabled then
        aim:CreateMobileButton()
        aim:SetMobileButtonVisible(true)
    end

    if aim.MobileWallCheckEnabled then
        aim:CreateWallCheckMobileButton()
        aim:SetWallCheckMobileButtonVisible(true)
    end

    Build(Group, prefix, aim, config)
    setupLivePlayerRefresh(aim)

    return aim
end

