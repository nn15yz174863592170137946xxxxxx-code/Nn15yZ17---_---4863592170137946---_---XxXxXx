-- ===== SECTIONS ===== --
local SECTIONS = {
    Enabled = {
        {"EnabledToggle"},
        {"LockAnywhere"},
        {"TeamCheck"},
        {"MaxDistance"},
        {"MobileQuickToggle"},
        {"Keybind"},
    },
    Target = {
        {"TargetPlayers"},
        {"TargetCustom"},
    },
    Lists = {
        {"Whitelist"},
        {"PriorityTarget"},
    },
    Prediction = {
        {"PredictionXZ"},
        {"PredictionY"},
        {"AutoPrediction"},
    },
    Targeting = {
        {"SampleMode"},
        {"AimPart"},
        {"HeadChance"},
    },
    FOV = {
        {"FOVSize"},
        {"CrossOffsetX"},
        {"CrossOffsetY"},
        {"FOVRainbowEnabled"},
        {"CrosshairRainbowEnabled"},
        {"RainbowSpeed"},
    },
}

local SECTION_ORDER = {
    "Enabled",
    "Target",
    "Lists",
    "Prediction",
    "Targeting",
    "FOV",
}

-- ===== BUILD ===== --
local function Build(Group, prefix, aim, config)
    config = config or {}
    local features = merge(DEFAULT_FEATURES, config.Features)

    local exclude = {}
    for _, id in ipairs(config.Exclude or {}) do
        exclude[id] = true
    end

    local sectionsBuilt = 0

    for _, sectionName in ipairs(SECTION_ORDER) do
        if features[sectionName] ~= false then
            local toRun = {}

            for _, entry in ipairs(SECTIONS[sectionName]) do
                local id = entry[1]
                if not exclude[id] then
                    table.insert(toRun, id)
                end
            end

            if #toRun > 0 then
                if sectionsBuilt > 0 then
                    Group:AddDivider()
                end
                for _, id in ipairs(toRun) do
                    if B[id] then B[id](Group, prefix, aim) end
                end
                sectionsBuilt = sectionsBuilt + 1
            end
        end
    end
end

-- ===== PLAYER LIST REFRESH ===== --
local function setupPlayerListRefresh(Players, LocalPlayer, aim)
    local function refresh()
        local names = buildPlayerOptions(Players, LocalPlayer)

        if aim._uiWhitelist and aim._uiWhitelist.SetValues then
            aim._uiWhitelist:SetValues(names)
        end

        if aim._uiPriorityTarget and aim._uiPriorityTarget.SetValues then
            aim._uiPriorityTarget:SetValues(names)
        end
    end

    Players.PlayerAdded:Connect(function()
        task.wait(0.3)
        refresh()
    end)

    Players.PlayerRemoving:Connect(function()
        task.wait(0.3)
        refresh()
    end)
end

-- ===== STATE SYNC ===== --
local function setupStateSync(aim)
    aim.OnStateChanged = function(state)
        local uiToggle = aim._uiToggle
        if uiToggle and uiToggle.Value ~= state then
            uiToggle:SetValue(state)
        end
    end
end

-- ===== FACTORY ===== --
local function Create(Group, prefix, Players, LocalPlayer, Camera, config, sources)
    config = config or {}

    local settings = merge(DEFAULTS, config.Settings)
    local aim = Aimlock.new(Players, LocalPlayer, Camera, settings)

    if sources then
        for _, src in ipairs(sources) do
            aim:AddTargetSource(src.Name, src.Getter, src.Enabled ~= false)
        end
    end

    aim:CreateFOV()
    setupStateSync(aim)

    if aim.MobileButtonEnabled then
        aim:CreateMobileButton()
        aim:SetMobileButtonVisible(true)
    end

    Build(Group, prefix, aim, config)
    setupPlayerListRefresh(Players, LocalPlayer, aim)

    return aim
end

-- ===== RETURN ===== --
return {
    Aimlock = Aimlock,
    Build = Build,
    Create = Create,
    Builders = B,
    DEFAULTS = DEFAULTS,
    DEFAULT_FEATURES = DEFAULT_FEATURES,
}
