-- ===== HELPERS ===== --
local function merge(a, b)
    local out = {}
    for k, v in pairs(a) do out[k] = v end
    if b then for k, v in pairs(b) do out[k] = v end end
    return out
end

local function buildSortedPlayerList(Players, LocalPlayer)
    local names = {}
    for _, plr in ipairs(Players:GetPlayers()) do
        if plr ~= LocalPlayer then
            names[#names + 1] = plr.Name
        end
    end
    table.sort(names)
    return names
end

-- ===== LIVE PLAYER DROPDOWN ===== --
local function makeLivePlayerDropdown(g, prefix, idx, text, target, field)
    local order = {}

    local dropdown = g:AddDropdown(prefix..idx, {
        Text = text,
        Values = buildSortedPlayerList(target.Players, target.LocalPlayer),
        Default = {},
        Multi = true,
        Searchable = true,
        Callback = function(selected)
            local newOrder = {}

            for _, name in ipairs(order) do
                if selected[name] then newOrder[#newOrder + 1] = name end
            end

            for name, checked in pairs(selected) do
                if checked and type(name) == "string" and not table.find(newOrder, name) then
                    newOrder[#newOrder + 1] = name
                end
            end

            order = newOrder
            target[field] = newOrder
        end,
    })

    return dropdown
end

