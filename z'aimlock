-- ===== AIMLOCK ===== --
local Aimlock = {}
Aimlock.__index = Aimlock

local RunService = game:GetService("RunService")

-- ===== CONSTRUCTOR ===== --
function Aimlock.new(playersService, localPlayer, camera, settings)
    settings = settings or {}
    local self = setmetatable({}, Aimlock)
    self.Players = playersService
    self.LocalPlayer = localPlayer
    self.Camera = camera

    self.AimlockName = settings.AimlockName or "Aimlock"
    self.Enabled = false
    self.LockAnywhere = settings.LockAnywhere or false
    self.TargetPlayers = settings.TargetPlayers ~= false
    self.TeamCheck = settings.TeamCheck or false
    self.TeamCheckFunc = settings.TeamCheckFunc or nil
    self.WallCheck = settings.WallCheck ~= false
    self.MaxDistance = settings.MaxDistance

    self.FOVSize = settings.FOVSize or 500
    self.CrossOffset = settings.CrossOffset or Vector2.new(0, 0)
    self.Gui = nil
    self.FOVCircle = nil
    self.CrossV = nil
    self.CrossH = nil
    self.FOVStroke = nil
    self.FOVRainbowEnabled = settings.FOVRainbowEnabled ~= false
    self.CrosshairRainbowEnabled = settings.CrosshairRainbowEnabled ~= false
    self.RainbowSpeed = settings.RainbowSpeed or 1

    self.PredictionXZ = settings.PredictionXZ or 0
    self.PredictionY = settings.PredictionY or 0
    self.AutoPredictionEnabled = settings.AutoPredictionEnabled or false

    self.AimPartPreference = settings.AimPartPreference or {"Head", "Torso", "Other Parts"}
    self.SampleMode = settings.SampleMode or 2
    self.HeadChance = settings.HeadChance or 80
    self.UpdateRate = settings.UpdateRate or 0

    self.MobileButtonEnabled = settings.MobileButtonEnabled ~= false
    self.MobileButton = nil
    self.MobileButtonGui = nil
    self.OnStateChanged = nil

    self.MobileWallCheckEnabled = settings.MobileWallCheckEnabled or false
    self.MobileWallCheckButton = nil
    self.MobileWallCheckGui = nil
    self.OnWallCheckChanged = nil

    local builtInWhitelist = settings.BuiltInWhitelist or {}
    local externalWhitelist = settings.Whitelist or {}
    if settings.RespectBuiltInWhitelist ~= false then
        self.Whitelist = {}
        for _, name in ipairs(builtInWhitelist) do self.Whitelist[#self.Whitelist + 1] = name end
        for _, name in ipairs(externalWhitelist) do
            if not table.find(self.Whitelist, name) then self.Whitelist[#self.Whitelist + 1] = name end
        end
    else
        self.Whitelist = externalWhitelist
    end

    self.Targetlist = settings.Targetlist or {}

    self.TargetSources = {}
    if settings.TargetSources then
        for name, src in pairs(settings.TargetSources) do
            self.TargetSources[name] = {
                Enabled = src.Enabled ~= false,
                GetEntities = src.GetEntities
            }
        end
    end

    self.LoopConnection = nil
    self.PriorityTarget = nil
    self._pointCache = {}
    self._ignoreList = {}

    self._rayParams = RaycastParams.new()
    self._rayParams.FilterType = Enum.RaycastFilterType.Blacklist
    self._rayParams.IgnoreWater = true
    self._rayParams.FilterDescendantsInstances = self._ignoreList

    self._acc = 0

    return self
end

-- ===== SOURCES ===== --
function Aimlock:AddTargetSource(name, getEntitiesFunc, startEnabled)
    self.TargetSources[name] = {
        Enabled = startEnabled ~= false,
        GetEntities = getEntitiesFunc
    }
end

-- ===== FOV ===== --
function Aimlock:CreateFOV(parent)
    if self.Gui then self.Gui:Destroy() end
    local gui = Instance.new("ScreenGui", parent or self.LocalPlayer.PlayerGui)
    gui.Name = self.AimlockName .. "FOV"
    gui.IgnoreGuiInset = true
    gui.ResetOnSpawn = false

    local function mk(pos, size)
        local f = Instance.new("Frame", gui)
        f.AnchorPoint = Vector2.new(0.5, 0.5)
        f.Position = pos
        f.Size = size
        f.BackgroundColor3 = Color3.new(1, 1, 1)
        f.BorderSizePixel = 0
        f.Visible = false
        return f
    end

    self.CrossV = mk(UDim2.new(0.5, self.CrossOffset.X, 0.5, self.CrossOffset.Y), UDim2.new(0, 2, 0, 14))
    self.CrossH = mk(UDim2.new(0.5, self.CrossOffset.X, 0.5, self.CrossOffset.Y), UDim2.new(0, 14, 0, 2))
    self.FOVCircle = mk(UDim2.new(0.5, self.CrossOffset.X, 0.5, self.CrossOffset.Y), UDim2.new(0, self.FOVSize, 0, self.FOVSize))
    self.FOVCircle.BackgroundTransparency = 1
    Instance.new("UICorner", self.FOVCircle).CornerRadius = UDim.new(1, 0)

    local stroke = Instance.new("UIStroke", self.FOVCircle)
    stroke.Thickness = 2
    self.FOVStroke = stroke

    task.spawn(function()
        local h = 0
        while self.FOVCircle and self.FOVCircle.Parent do
            task.wait(0.03)
            h = (h + 3 * (self.RainbowSpeed or 1)) % 360
            local c = Color3.fromHSV(h / 360, 1, 1)
            if self.FOVRainbowEnabled and self.FOVStroke and self.FOVCircle.Visible then
                self.FOVStroke.Color = c
            end
            if self.CrosshairRainbowEnabled then
                if self.CrossV and self.CrossV.Visible then self.CrossV.BackgroundColor3 = c end
                if self.CrossH and self.CrossH.Visible then self.CrossH.BackgroundColor3 = c end
            end
        end
    end)

    self.Gui = gui
end

function Aimlock:SetVisibility(visible)
    if self.FOVCircle then self.FOVCircle.Visible = visible end
    if self.CrossV then self.CrossV.Visible = visible end
    if self.CrossH then self.CrossH.Visible = visible end
end

function Aimlock:UpdateFOVSize(size)
    self.FOVSize = size
    if self.FOVCircle then
        self.FOVCircle.Size = UDim2.new(0, size, 0, size)
        self.FOVCircle.Position = UDim2.new(0.5, self.CrossOffset.X, 0.5, self.CrossOffset.Y)
    end
end

function Aimlock:UpdateCrossOffset(offset)
    self.CrossOffset = offset
    if self.FOVCircle then self.FOVCircle.Position = UDim2.new(0.5, offset.X, 0.5, offset.Y) end
    if self.CrossV then self.CrossV.Position = UDim2.new(0.5, offset.X, 0.5, offset.Y) end
    if self.CrossH then self.CrossH.Position = UDim2.new(0.5, offset.X, 0.5, offset.Y) end
end

-- ===== PREDICTION ===== --
function Aimlock:GetPredictedPos(point, vel, targetChar)
    if self.AutoPredictionEnabled then
        local ping = self.LocalPlayer:GetNetworkPing()
        local g = workspace.Gravity
        local hum = targetChar and targetChar:FindFirstChildOfClass("Humanoid")
        local airborne = hum and hum.FloorMaterial == Enum.Material.Air

        local predX = vel.X * ping
        local predZ = vel.Z * ping
        local predY
        if airborne then
            predY = vel.Y * ping - 0.5 * g * ping * ping
        else
            predY = 0
        end
        return point + Vector3.new(predX, predY, predZ)
    end

    if self.PredictionXZ == 0 and self.PredictionY == 0 then return point end
    return point + Vector3.new(
        vel.X * self.PredictionXZ,
        vel.Y * self.PredictionY,
        vel.Z * self.PredictionXZ
    )
end

-- ===== TEAM ===== --
function Aimlock:IsSameTeam(plr)
    if not self.TeamCheck then return false end
    if self.TeamCheckFunc then
        local ok, result = pcall(self.TeamCheckFunc, plr, self.LocalPlayer)
        if ok then return result end
    end
    return plr.TeamColor == self.LocalPlayer.TeamColor
end

-- ===== GRID SAMPLING ===== --
function Aimlock:GetSurfacePoints(size, mode)
    local key = size.X .. "|" .. size.Y .. "|" .. size.Z .. "|" .. mode
    local cached = self._pointCache[key]
    if cached then return cached end

    local points = {}
    local hx, hy, hz = size.X / 2, size.Y / 2, size.Z / 2

    if mode == 1 then
        points[1] = Vector3.new(0, 0, 0)
    elseif mode == 2 then
        for ix = -1, 1, 2 do
            for iy = -1, 1, 2 do
                for iz = -1, 1, 2 do
                    points[#points + 1] = Vector3.new(ix * hx, iy * hy, iz * hz)
                end
            end
        end
    else
        for ix = -1, 1 do
            for iy = -1, 1 do
                for iz = -1, 1 do
                    points[#points + 1] = Vector3.new(ix * hx, iy * hy, iz * hz)
                end
            end
        end
    end

    self._pointCache[key] = points
    return points
end

function Aimlock:GetClosestVisiblePoint(part, targetChar, camPos, ignoreChar)
    if not part or not part:IsA("BasePart") then return nil end

    if not self.WallCheck then
        return part.Position
    end

    local params = self._rayParams
    local ignoreList = self._ignoreList
    ignoreList[1] = ignoreChar
    params.FilterDescendantsInstances = ignoreList

    local partPos = part.Position
    local centerDir = partPos - camPos

    local centerResult = workspace:Raycast(camPos, centerDir, params)
    if centerResult then
        local hit = centerResult.Instance
        if hit == part or hit:IsDescendantOf(targetChar) then
            return partPos
        end
    end

    if self.SampleMode == 1 then
        return nil
    end

    local points = self:GetSurfacePoints(part.Size, self.SampleMode)
    local closestPoint, closestDist = nil, math.huge
    local count = #points
    for i = 1, count do
        local p = points[i]
        if p.X ~= 0 or p.Y ~= 0 or p.Z ~= 0 then
            local checkPoint = partPos + p
            local dir = checkPoint - camPos
            local dist = dir.Magnitude
            if dist < closestDist then
                local result = workspace:Raycast(camPos, dir, params)
                if result then
                    local hit = result.Instance
                    if hit == part or hit:IsDescendantOf(targetChar) then
                        closestPoint = checkPoint
                        closestDist = dist
                    end
                end
            end
        end
    end
    return closestPoint
end

-- ===== BUCKET RESOLUTION ===== --
function Aimlock:ResolveBucketList(entity, bucket)
    local parts = {}
    if not entity or not entity:IsA("Model") then return parts end

    if bucket == "Head" then
        local p = entity:FindFirstChild("Head")
        if p and p:IsA("BasePart") then parts[1] = p end
        return parts
    end

    if bucket == "Torso" then
        for _, name in ipairs({"UpperTorso", "Torso", "HumanoidRootPart", "LowerTorso"}) do
            local p = entity:FindFirstChild(name)
            if p and p:IsA("BasePart") then parts[#parts + 1] = p end
        end
        return parts
    end

    if bucket == "Other Parts" then
        for _, name in ipairs({
            "LeftUpperArm", "LeftLowerArm", "LeftHand",
            "RightUpperArm", "RightLowerArm", "RightHand",
            "LeftUpperLeg", "LeftLowerLeg", "LeftFoot",
            "RightUpperLeg", "RightLowerLeg", "RightFoot"
        }) do
            local p = entity:FindFirstChild(name)
            if p and p:IsA("BasePart") then parts[#parts + 1] = p end
        end

        for _, name in ipairs({"Left Arm", "Right Arm", "Left Leg", "Right Leg"}) do
            local p = entity:FindFirstChild(name)
            if p and p:IsA("BasePart") then parts[#parts + 1] = p end
        end

        for _, c in ipairs(entity:GetChildren()) do
            if c:IsA("BasePart") and not table.find(parts, c) then
                local lower = c.Name:lower()
                if not (lower:find("head") or lower:find("torso") or lower:find("humanoidrootpart")) then
                    parts[#parts + 1] = c
                end
            end
        end

        if #parts == 0 then
            for _, c in ipairs(entity:GetDescendants()) do
                if c:IsA("BasePart") then parts[#parts + 1] = c end
            end
        end

        return parts
    end

    return parts
end

function Aimlock:ResolveBucket(entity, bucket)
    local list = self:ResolveBucketList(entity, bucket)
    return list[1]
end

-- ===== AIM PARTS ===== --
function Aimlock:GetAimParts(entity)
    if not entity then return {} end

    local preference = self.AimPartPreference
    if not preference or #preference == 0 then
        local p = entity:FindFirstChildWhichIsA("BasePart")
        return p and {p} or {}
    end

    local headChance = self.HeadChance or 80
    local roll = math.random() * 100

    local primary
    if roll < headChance and table.find(preference, "Head") then
        primary = "Head"
    elseif table.find(preference, "Torso") then
        primary = "Torso"
    elseif table.find(preference, "Other Parts") then
        primary = "Other Parts"
    elseif table.find(preference, "Head") then
        primary = "Head"
    else
        primary = preference[1]
    end

    local bucketOrder = {primary}
    for _, name in ipairs(preference) do
        if name ~= primary then
            bucketOrder[#bucketOrder + 1] = name
        end
    end

    local result = {}
    local seen = {}
    for _, bucket in ipairs(bucketOrder) do
        local bucketParts = self:ResolveBucketList(entity, bucket)
        for _, p in ipairs(bucketParts) do
            if not seen[p] then
                seen[p] = true
                result[#result + 1] = p
            end
        end
    end

    if #result == 0 then
        local p = entity:FindFirstChildWhichIsA("BasePart")
        if p then result[1] = p end
    end

    return result
end

function Aimlock:GetAimPart(entity)
    local parts = self:GetAimParts(entity)
    return parts[1]
end

-- ===== CANDIDATE SCORING (FOV + crosshair only) ===== --
function Aimlock:GetCandidateRoot(entity)
    return entity:FindFirstChild("HumanoidRootPart")
        or entity:FindFirstChild("Head")
        or entity:FindFirstChildWhichIsA("BasePart")
end

function Aimlock:GetScreenDistance(entity, camPos, fPos, maxScreenDist)
    local hum = entity:FindFirstChildOfClass("Humanoid")
    if not hum or hum.Health <= 0 then return nil end

    local root = self:GetCandidateRoot(entity)
    if not root then return nil end

    if self.MaxDistance then
        local wd = (camPos - root.Position).Magnitude
        if wd > self.MaxDistance then return nil end
    end

    if self.LockAnywhere then
        return 0, root
    end

    local sp, onScreen = self.Camera:WorldToViewportPoint(root.Position)
    if not onScreen then return nil end

    local dx = sp.X - fPos.X
    local dy = sp.Y - fPos.Y
    local d = math.sqrt(dx * dx + dy * dy)
    if d > maxScreenDist then return nil end

    return d, root
end

-- ===== TARGET SEARCH ===== --
function Aimlock:FindBestTarget()
    local char = self.LocalPlayer.Character
    if not char then return nil end
    if not char:FindFirstChild("HumanoidRootPart") then return nil end

    local camPos = self.Camera.CFrame.Position
    local vp = self.Camera.ViewportSize
    local fPos = Vector2.new(vp.X / 2 + self.CrossOffset.X, vp.Y / 2 + self.CrossOffset.Y)
    local maxScreenDist = self.FOVSize / 2

    local bestEntity, bestDist, bestPart, bestPoint = nil, math.huge, nil, nil

    local function evaluate(entity)
        if not entity or not entity.Parent then return end

        local d = self:GetScreenDistance(entity, camPos, fPos, maxScreenDist)
        if not d then return end
        if d >= bestDist then return end

        local parts = self:GetAimParts(entity)
        for i = 1, #parts do
            local point = self:GetClosestVisiblePoint(parts[i], entity, camPos, char)
            if point then
                bestEntity = entity
                bestDist = d
                bestPart = parts[i]
                bestPoint = point
                return
            end
        end
    end

    local pt = self.PriorityTarget
    if self.TargetPlayers and pt and pt.Character then
        if not table.find(self.Whitelist, pt.Name) and not self:IsSameTeam(pt) then
            evaluate(pt.Character)
        end
    end

    local tlist = self.Targetlist
    if self.TargetPlayers and tlist and #tlist > 0 then
        for _, plr in ipairs(self.Players:GetPlayers()) do
            if plr ~= self.LocalPlayer
                and table.find(tlist, plr.Name)
                and not table.find(self.Whitelist, plr.Name)
                and not self:IsSameTeam(plr) then
                evaluate(plr.Character)
            end
        end
    end

    if self.TargetPlayers then
        for _, plr in ipairs(self.Players:GetPlayers()) do
            if plr ~= self.LocalPlayer
                and not table.find(self.Whitelist, plr.Name)
                and not self:IsSameTeam(plr) then
                evaluate(plr.Character)
            end
        end
    end

    for _, src in pairs(self.TargetSources) do
        if src.Enabled then
            local entities = src.GetEntities()
            if entities then
                for i = 1, #entities do
                    local e = entities[i]
                    if typeof(e) == "Instance" and e:IsA("Model") then
                        evaluate(e)
                    end
                end
            end
        end
    end

    if not bestEntity then return nil end

    local vel = bestPart.AssemblyLinearVelocity or bestPart.Velocity
    local predicted = self:GetPredictedPos(bestPoint, vel, bestEntity)

    if self.LockAnywhere then return predicted end

    local sp, onScreen = self.Camera:WorldToViewportPoint(predicted)
    if onScreen then
        local dx = sp.X - fPos.X
        local dy = sp.Y - fPos.Y
        local d = math.sqrt(dx * dx + dy * dy)
        if d <= maxScreenDist then
            return predicted
        end
    end

    return nil
end

-- ===== LOOP ===== --
function Aimlock:Start()
    if self.LoopConnection then return end
    self._acc = 0
    local interval = self.UpdateRate > 0 and (1 / self.UpdateRate) or 0

    self.LoopConnection = RunService.RenderStepped:Connect(function(dt)
        if not self.Enabled then return end

        if interval > 0 then
            self._acc = self._acc + dt
            if self._acc < interval then return end
            self._acc = 0
        end

        local targetPos = self:FindBestTarget()
        if not targetPos then return end

        local camPos = self.Camera.CFrame.Position
        local lookAt = CFrame.lookAt(camPos, targetPos)

        if self.CrossOffset.X ~= 0 or self.CrossOffset.Y ~= 0 then
            local fovRad = math.rad(self.Camera.FieldOfView)
            local vp = self.Camera.ViewportSize
            if self.CrossOffset.X ~= 0 then
                lookAt = lookAt * CFrame.Angles(0, -self.CrossOffset.X * (fovRad / vp.X), 0)
            end
            if self.CrossOffset.Y ~= 0 then
                lookAt = lookAt * CFrame.Angles(-self.CrossOffset.Y * (fovRad / vp.Y), 0, 0)
            end
        end

        self.Camera.CFrame = lookAt
    end)
end

function Aimlock:Stop()
    if self.LoopConnection then
        self.LoopConnection:Disconnect()
        self.LoopConnection = nil
    end
end

function Aimlock:SetEnabled(state)
    if self.Enabled == state then
        self:UpdateMobileButton()
        return
    end
    self.Enabled = state
    self:SetVisibility(state)
    if state then self:Start() else self:Stop() end
    self:UpdateMobileButton()
    if self.OnStateChanged then self:OnStateChanged(state) end
end

function Aimlock:SetWallCheck(state)
    if self.WallCheck == state then
        self:UpdateWallCheckButton()
        return
    end
    self.WallCheck = state
    self:UpdateWallCheckButton()
    if self.OnWallCheckChanged then self:OnWallCheckChanged(state) end
end

-- ===== MOBILE BUTTON ===== --
function Aimlock:CreateMobileButton()
    if self.MobileButtonGui then
        self.MobileButtonGui.Enabled = true
        self:UpdateMobileButton()
        return
    end

    local gui = Instance.new("ScreenGui")
    gui.Name = self.AimlockName .. "MobileToggle"
    gui.IgnoreGuiInset = true
    gui.ResetOnSpawn = false
    gui.Parent = self.LocalPlayer:WaitForChild("PlayerGui")

    local btn = Instance.new("TextButton")
    btn.Size = UDim2.new(0, 140, 0, 40)
    btn.Position = UDim2.new(0.875, 0, 0.125, 0)
    btn.Text = "Aimlock : OFF"
    btn.TextColor3 = Color3.new(1, 1, 1)
    btn.BackgroundColor3 = Color3.new(0, 0, 0)
    btn.TextScaled = true
    btn.Font = Enum.Font.SourceSansBold
    btn.Draggable = true
    btn.Active = true
    btn.Parent = gui

    Instance.new("UICorner", btn).CornerRadius = UDim.new(0, 10)

    self.MobileButton = btn
    self.MobileButtonGui = gui

    btn.MouseButton1Click:Connect(function()
        self:SetEnabled(not self.Enabled)
    end)

    self:UpdateMobileButton()
end

function Aimlock:SetMobileButtonVisible(visible)
    if not self.MobileButtonGui then
        if visible then self:CreateMobileButton() end
        return
    end
    self.MobileButtonGui.Enabled = visible
end

function Aimlock:DestroyMobileButton()
    if self.MobileButtonGui then
        self.MobileButtonGui:Destroy()
        self.MobileButtonGui = nil
        self.MobileButton = nil
    end
end

function Aimlock:UpdateMobileButton()
    if not self.MobileButton then return end
    if self.Enabled then
        self.MobileButton.Text = "Aimlock : ON"
        self.MobileButton.BackgroundColor3 = Color3.fromRGB(255, 128, 0)
    else
        self.MobileButton.Text = "Aimlock : OFF"
        self.MobileButton.BackgroundColor3 = Color3.new(0, 0, 0)
    end
end

-- ===== WALL CHECK MOBILE BUTTON ===== --
function Aimlock:CreateWallCheckMobileButton()
    if self.MobileWallCheckGui then
        self.MobileWallCheckGui.Enabled = true
        self:UpdateWallCheckButton()
        return
    end

    local gui = Instance.new("ScreenGui")
    gui.Name = self.AimlockName .. "WallCheckMobileToggle"
    gui.IgnoreGuiInset = true
    gui.ResetOnSpawn = false
    gui.Parent = self.LocalPlayer:WaitForChild("PlayerGui")

    local btn = Instance.new("TextButton")
    btn.Size = UDim2.new(0, 140, 0, 40)
    btn.Position = UDim2.new(0.875, 0, 0.2, 0)
    btn.Text = "Wall Check : ON"
    btn.TextColor3 = Color3.new(1, 1, 1)
    btn.BackgroundColor3 = Color3.fromRGB(50, 150, 50)
    btn.TextScaled = true
    btn.Font = Enum.Font.SourceSansBold
    btn.Draggable = true
    btn.Active = true
    btn.Parent = gui

    Instance.new("UICorner", btn).CornerRadius = UDim.new(0, 10)

    self.MobileWallCheckButton = btn
    self.MobileWallCheckGui = gui

    btn.MouseButton1Click:Connect(function()
        self:SetWallCheck(not self.WallCheck)
    end)

    self:UpdateWallCheckButton()
end

function Aimlock:SetWallCheckMobileButtonVisible(visible)
    if not self.MobileWallCheckGui then
        if visible then self:CreateWallCheckMobileButton() end
        return
    end
    self.MobileWallCheckGui.Enabled = visible
end

function Aimlock:DestroyWallCheckMobileButton()
    if self.MobileWallCheckGui then
        self.MobileWallCheckGui:Destroy()
        self.MobileWallCheckGui = nil
        self.MobileWallCheckButton = nil
    end
end

function Aimlock:UpdateWallCheckButton()
    if not self.MobileWallCheckButton then return end
    if self.WallCheck then
        self.MobileWallCheckButton.Text = "Wall Check : ON"
        self.MobileWallCheckButton.BackgroundColor3 = Color3.fromRGB(50, 150, 50)
    else
        self.MobileWallCheckButton.Text = "Wall Check : OFF"
        self.MobileWallCheckButton.BackgroundColor3 = Color3.new(0, 0, 0)
    end
end

-- ===== DESTROY ===== --
function Aimlock:Destroy()
    self:Stop()
    if self.Gui then
        self.Gui:Destroy()
        self.Gui = nil
    end
    self:DestroyMobileButton()
    self:DestroyWallCheckMobileButton()
end

return Aimlock
