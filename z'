-- ===== helpers ===== --
local function safeLoad(url, label)
    local success, err = pcall(function()
        loadstring(game:HttpGet(url))()
    end)
    if not success then
        Library:Notify("Failed: " .. label, 5)
        warn("[Loader] " .. label .. " -> " .. tostring(err))
    end
    return success
end

