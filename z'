-- ===== GAME NAME override ===== --
if _G.GameName then
    local targetName = _G.GameName:lower()
    local found = false

    for _, g in ipairs(Games) do
        if g.name:lower() == targetName then
            found = true
            if table.find(g.universeIds, UniverseId) then
                Library:Notify('Loading "' .. g.name .. '"', 3)
                safeLoad(BASE .. g.file, g.name)
            else
                Library:Notify("Game not supported.", 3)
            end
            break
        end
    end

    if not found then
        Library:Notify("Game '" .. _G.GameName .. "' not found in list.", 3)
    end
    return
end

