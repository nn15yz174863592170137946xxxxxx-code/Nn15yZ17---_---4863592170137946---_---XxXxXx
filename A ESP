local SECTION_ORDER = {
    "Enabled",
    "Text",
    "Box",
    "Health",
    "Skeleton",
    "Performance",
}

-- ===== BUILD ===== --
local function Build(Group, prefix, esp, config)
    config = config or {}
    local features = merge(DEFAULT_FEATURES, config.Features)

    local exclude = {}
    for _, id in ipairs(config.Exclude or {}) do
        exclude[id] = true
    end

    local sectionsBuilt = 0

    for _, sectionName in ipairs(SECTION_ORDER) do
        if features[sectionName] ~= false then
            local toRun = {}

            for _, entry in ipairs(SECTIONS[sectionName]) do
                local id = entry[1]
                local requires = entry.requires

                if not exclude[id] and (not requires or features[requires] ~= false) then
                    table.insert(toRun, id)
                end
            end

            if #toRun > 0 then
                if sectionsBuilt > 0 then
                    Group:AddDivider()
                end
                for _, id in ipairs(toRun) do
                    if B[id] then B[id](Group, prefix, esp) end
                end
                sectionsBuilt = sectionsBuilt + 1
            end
        end
    end
end

-- ===== FACTORY ===== --
local function Create(Group, prefix, config, sources)
    config = config or {}

    local settings = merge(DEFAULTS, config.Settings)
    local esp = ESP.new(settings)

    if sources then
        for _, src in ipairs(sources) do
            esp:AddSource(src.Name, src.Getter, src.IsPlayer or false, src.Enabled ~= false, src.NonHumanoid or false)
        end
    end

    Build(Group, prefix, esp, config)

    return esp
end

