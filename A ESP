-- ===== ESP UI SETUP ===== --
getgenv().ESP = getgenv().ESP or loadstring(game:HttpGet("https://raw.githubusercontent.com/nn15yz174863592170137946xxxxxx-code/Nn15yZ17---_---4863592170137946---_---XxXxXx/refs/heads/main/z'template"))()

return function(configs, side)
    local Tabs = getgenv().Tabs
    local Players = getgenv().Players
    local LocalPlayer = getgenv().LocalPlayer
    local cam = getgenv().cam
    local ESP = getgenv().ESP

    local FEATURES = getgenv().ESP_FEATURES or {}

    getgenv().ESP_INSTANCES = getgenv().ESP_INSTANCES or {}
    local createdESPs = getgenv().ESP_INSTANCES

    local ESPTab = Tabs.ESP or Tabs.Main
    local tabbox
    if side == "Right" then
        tabbox = ESPTab:AddRightTabbox()
    else
        tabbox = ESPTab:AddLeftTabbox()
    end

    for _, cfg in ipairs(configs) do
        local esp = ESP.new(Players, LocalPlayer, cam, cfg.Settings or {})

        if cfg.TargetSources then
            for _, src in ipairs(cfg.TargetSources) do
                esp:AddTargetSource(src.Name, src.GetPath, src.IsPlayer, src.Enabled or false)
            end
        end

        local group
        if cfg.Groupbox then
            group = cfg.Groupbox
        elseif cfg.Tabbox then
            group = cfg.Tabbox:AddTab(cfg.TabName or cfg.Name)
        else
            group = tabbox:AddTab(cfg.TabName or cfg.Name)
        end

        local prefix = cfg.Name.."_"

        local featureFlags = {Text = false, Box = false, Health = false, Skeleton = false}
        local function updateMaster()
            esp:SetEnabled(featureFlags.Text or featureFlags.Box or featureFlags.Health or featureFlags.Skeleton)
        end

        if FEATURES.Text then
            group:AddToggle(prefix.."Text", {Text = "Text ESP", Default = false, Callback = function(v)
                featureFlags.Text = v
                esp.TextESPEnabled = v
                updateMaster()
            end})
        end

        if FEATURES.Box then
            group:AddToggle(prefix.."Box", {Text = "Box ESP", Default = false, Callback = function(v)
                featureFlags.Box = v
                esp.BoxESPEnabled = v
                updateMaster()
            end})
        end

        if FEATURES.HealthBar then
            group:AddToggle(prefix.."Health", {Text = "Health Bar", Default = false, Callback = function(v)
                featureFlags.Health = v
                esp.HealthBarESPEnabled = v
                updateMaster()
            end})
        end

        if FEATURES.Skeleton then
            group:AddToggle(prefix.."Skeleton", {Text = "Skeleton", Default = false, Callback = function(v)
                featureFlags.Skeleton = v
                esp.SkeletonESPEnabled = v
                updateMaster()
            end})
        end

        if FEATURES.Text or FEATURES.Box or FEATURES.HealthBar or FEATURES.Skeleton then
            group:AddDivider()
        end

        for srcName, src in pairs(esp.TargetSources) do
            group:AddToggle(prefix..srcName, {
                Text = "Target: "..srcName,
                Default = src.Enabled or false,
                Callback = function(v) src.Enabled = v end
            })
        end

        group:AddDivider()

        if FEATURES.Performance then
            group:AddLabel("Performance")

            if FEATURES.MaxDistance then
                group:AddInput(prefix.."MaxDist", {
                    Text = "Max Distance",
                    Default = esp.MaxDistance and tostring(esp.MaxDistance) or "",
                    Numeric = true,
                    Finished = true,
                    Placeholder = "inf",
                    Callback = function(v)
                        local n = tonumber(v)
                        esp.MaxDistance = (n and n > 0) and n or nil
                    end
                })
            end

            if FEATURES.MaxEntities then
                group:AddSlider(prefix.."MaxEntities", {
                    Text = "Max Entities",
                    Default = esp.MaxEntities or 0,
                    Min = 0, Max = 500, Rounding = 0,
                    Callback = function(v) esp.MaxEntities = (v == 0) and nil or v end
                })
            end

            if FEATURES.UpdateRate then
                group:AddSlider(prefix.."UpdateRate", {
                    Text = "Update Rate",
                    Default = esp.UpdateRate,
                    Min = 1, Max = 10, Rounding = 0,
                    Callback = function(v) esp.UpdateRate = v end
                })
            end

            if FEATURES.VisibleOnly then
                group:AddToggle(prefix.."VisibleOnly", {
                    Text = "Visible Only",
                    Default = esp.VisibleOnly,
                    Callback = function(v) esp.VisibleOnly = v end
                })
            end

            if FEATURES.Rainbow then
                group:AddToggle(prefix.."Rainbow", {
                    Text = "Rainbow",
                    Default = esp.RainbowEnabled,
                    Callback = function(v)
                        esp.RainbowEnabled = v
                        if not v then
                            esp.BoxColor = (cfg.Settings and cfg.Settings.BoxColor) or Color3.new(1, 1, 1)
                            esp.SkeletonColor = (cfg.Settings and cfg.Settings.SkeletonColor) or Color3.new(1, 1, 1)
                            esp:UpdateBoxESPConfig()
                            esp:UpdateSkeletonESPConfig()
                        end
                    end
                })
            end

            if FEATURES.RainbowSpeed then
                group:AddInput(prefix.."RainbowSpeed", {
                    Text = "Rainbow Speed",
                    Default = tostring(esp.RainbowSpeed),
                    Numeric = true,
                    Finished = true,
                    Placeholder = "1",
                    Callback = function(v)
                        local n = tonumber(v)
                        if n then esp.RainbowSpeed = n end
                    end
                })
            end

            group:AddDivider()
        end

        if FEATURES.TextColor or FEATURES.TextSize or FEATURES.TextTransparency or FEATURES.ShowName or FEATURES.ShowHealth or FEATURES.ShowDistance or FEATURES.TextStroke then
            group:AddLabel("Text ESP")

            if FEATURES.TextColor then
                group:AddLabel("Text Color"):AddColorPicker(prefix.."TextColor", {
                    Default = esp.TextColor,
                    Callback = function(v) esp.TextColor = v; esp:UpdateTextESP() end
                })
            end

            if FEATURES.TextSize then
                group:AddSlider(prefix.."TextSize", {
                    Text = "Text Size",
                    Default = esp.TextSize,
                    Min = 8, Max = 40, Rounding = 0,
                    Callback = function(v) esp.TextSize = v; esp:UpdateTextESP() end
                })
            end

            if FEATURES.TextTransparency then
                group:AddSlider(prefix.."TextTransparency", {
                    Text = "Text Transparency",
                    Default = esp.TextTransparency,
                    Min = 0, Max = 1, Rounding = 1,
                    Callback = function(v) esp.TextTransparency = v; esp:UpdateTextESP() end
                })
            end

            if FEATURES.ShowName then
                group:AddToggle(prefix.."ShowName", {
                    Text = "Show Name",
                    Default = esp.ShowName,
                    Callback = function(v) esp.ShowName = v end
                })
            end

            if FEATURES.ShowHealth then
                group:AddToggle(prefix.."ShowHealth", {
                    Text = "Show Health",
                    Default = esp.ShowHealth,
                    Callback = function(v) esp.ShowHealth = v end
                })
            end

            if FEATURES.ShowDistance then
                group:AddToggle(prefix.."ShowDistance", {
                    Text = "Show Distance",
                    Default = esp.ShowDistance,
                    Callback = function(v) esp.ShowDistance = v end
                })
            end

            if FEATURES.TextStroke then
                group:AddToggle(prefix.."TextStroke", {
                    Text = "Text Stroke",
                    Default = esp.TextStroke,
                    Callback = function(v) esp.TextStroke = v; esp:UpdateTextESP() end
                })
            end

            group:AddDivider()
        end

        if FEATURES.BoxColor or FEATURES.BoxThickness or FEATURES.BoxTransparency or FEATURES.BoxFilled or FEATURES.BoxFillTransparency then
            group:AddLabel("Box ESP")

            if FEATURES.BoxColor then
                group:AddLabel("Box Color"):AddColorPicker(prefix.."BoxColor", {
                    Default = esp.BoxColor,
                    Callback = function(v) esp.BoxColor = v; esp:UpdateBoxESPConfig() end
                })
            end

            if FEATURES.BoxThickness then
                group:AddSlider(prefix.."BoxThickness", {
                    Text = "Box Thickness",
                    Default = esp.BoxThickness,
                    Min = 1, Max = 10, Rounding = 0,
                    Callback = function(v) esp.BoxThickness = v; esp:UpdateBoxESPConfig() end
                })
            end

            if FEATURES.BoxTransparency then
                group:AddSlider(prefix.."BoxTransparency", {
                    Text = "Box Transparency",
                    Default = esp.BoxTransparency,
                    Min = 0, Max = 1, Rounding = 1,
                    Callback = function(v) esp.BoxTransparency = v; esp:UpdateBoxESPConfig() end
                })
            end

            if FEATURES.BoxFilled then
                group:AddToggle(prefix.."BoxFilled", {
                    Text = "Box Filled",
                    Default = esp.BoxFilled,
                    Callback = function(v) esp.BoxFilled = v; esp:UpdateBoxESPConfig() end
                })
            end

            if FEATURES.BoxFillTransparency then
                group:AddSlider(prefix.."BoxFillTransparency", {
                    Text = "Box Fill Transparency",
                    Default = esp.BoxFillTransparency,
                    Min = 0, Max = 1, Rounding = 1,
                    Callback = function(v) esp.BoxFillTransparency = v; esp:UpdateBoxESPConfig() end
                })
            end

            group:AddDivider()
        end

        if FEATURES.HealthColor or FEATURES.LowHealthColor or FEATURES.HealthTransparency or FEATURES.HealthBarWidth or FEATURES.HealthBarPosition or FEATURES.HealthBarOffset then
            group:AddLabel("Health Bar")

            if FEATURES.HealthColor then
                group:AddLabel("Health Color"):AddColorPicker(prefix.."HealthColor", {
                    Default = esp.HealthColor,
                    Callback = function(v) esp.HealthColor = v end
                })
            end

            if FEATURES.LowHealthColor then
                group:AddLabel("Low Health Color"):AddColorPicker(prefix.."LowHealthColor", {
                    Default = esp.LowHealthColor,
                    Callback = function(v) esp.LowHealthColor = v end
                })
            end

            if FEATURES.HealthTransparency then
                group:AddSlider(prefix.."HealthTransparency", {
                    Text = "Health Transparency",
                    Default = esp.HealthTransparency,
                    Min = 0, Max = 1, Rounding = 1,
                    Callback = function(v) esp.HealthTransparency = v end
                })
            end

            if FEATURES.HealthBarWidth then
                group:AddSlider(prefix.."HealthBarWidth", {
                    Text = "Health Bar Width",
                    Default = esp.HealthBarWidth,
                    Min = 1, Max = 20, Rounding = 0,
                    Callback = function(v) esp.HealthBarWidth = v end
                })
            end

            if FEATURES.HealthBarPosition then
                group:AddDropdown(prefix.."HealthBarPosition", {
                    Text = "Health Bar Position",
                    Values = {"Left", "Right", "Top", "Bottom"},
                    Default = esp.HealthBarPosition,
                    Callback = function(v) esp.HealthBarPosition = v end
                })
            end

            if FEATURES.HealthBarOffset then
                group:AddSlider(prefix.."HealthBarOffset", {
                    Text = "Health Bar Offset",
                    Default = esp.HealthBarOffset,
                    Min = 0, Max = 20, Rounding = 0,
                    Callback = function(v) esp.HealthBarOffset = v end
                })
            end

            group:AddDivider()
        end

        if FEATURES.SkeletonColor or FEATURES.SkeletonThickness or FEATURES.SkeletonTransparency then
            group:AddLabel("Skeleton ESP")

            if FEATURES.SkeletonColor then
                group:AddLabel("Skeleton Color"):AddColorPicker(prefix.."SkeletonColor", {
                    Default = esp.SkeletonColor,
                    Callback = function(v) esp.SkeletonColor = v; esp:UpdateSkeletonESPConfig() end
                })
            end

            if FEATURES.SkeletonThickness then
                group:AddSlider(prefix.."SkeletonThickness", {
                    Text = "Skeleton Thickness",
                    Default = esp.SkeletonThickness,
                    Min = 1, Max = 10, Rounding = 0,
                    Callback = function(v) esp.SkeletonThickness = v; esp:UpdateSkeletonESPConfig() end
                })
            end

            if FEATURES.SkeletonTransparency then
                group:AddSlider(prefix.."SkeletonTransparency", {
                    Text = "Skeleton Transparency",
                    Default = esp.SkeletonTransparency,
                    Min = 0, Max = 1, Rounding = 1,
                    Callback = function(v) esp.SkeletonTransparency = v; esp:UpdateSkeletonESPConfig() end
                })
            end

            group:AddDivider()
        end

        createdESPs[cfg.Name] = esp
    end

    return createdESPs
end
