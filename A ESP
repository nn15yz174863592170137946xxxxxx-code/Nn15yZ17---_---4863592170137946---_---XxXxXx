-- ===== TEXT ESP ===== --
local TextESP = {}
TextESP.__index = TextESP

local TextPlayers = game:GetService("Players")
local TextRunService = game:GetService("RunService")
local TextLocalPlayer = TextPlayers.LocalPlayer
local TextPlayerGui = TextLocalPlayer:WaitForChild("PlayerGui")

local function textRound(num, numDecimalPlaces)
    local mult = 10 ^ (numDecimalPlaces or 0)
    return math.floor(num * mult + 0.5) / mult
end

local function textGetRoot(character)
    return character:FindFirstChild("HumanoidRootPart") or character:FindFirstChild("Torso") or character:FindFirstChild("Head")
end

function TextESP.new(settings)
    settings = settings or {}
    local self = setmetatable({}, TextESP)
    self.Enabled = false
    self.ShowName = settings.ShowName ~= false
    self.ShowHealth = settings.ShowHealth ~= false
    self.ShowDistance = settings.ShowDistance ~= false
    self.TextColor = settings.TextColor or Color3.new(1, 1, 1)
    self.TextSize = settings.TextSize or 20
    self.TextStroke = settings.TextStroke ~= false
    self.Folder = {}
    self.PlayerAddedConn = nil
    self.PlayerRemovingConn = nil
    return self
end

function TextESP:CreateForPlayer(plr)
    if not self.Enabled then return end
    if plr == TextLocalPlayer then return end

    task.spawn(function()
        local folderName = plr.Name .. "_TESP"

        if self.Folder[plr] then
            self.Folder[plr]:Destroy()
            self.Folder[plr] = nil
        end

        if not plr.Character then return end
        repeat task.wait() until plr.Character and textGetRoot(plr.Character) and plr.Character:FindFirstChildOfClass("Humanoid")
        if not self.Enabled then return end

        local head = plr.Character:FindFirstChild("Head")
        if not head then return end

        local holder = Instance.new("Folder")
        holder.Name = folderName
        holder.Parent = TextPlayerGui
        self.Folder[plr] = holder

        local billboard = Instance.new("BillboardGui")
        billboard.Adornee = head
        billboard.Name = plr.Name
        billboard.Parent = holder
        billboard.Size = UDim2.new(0, 100, 0, 150)
        billboard.StudsOffset = Vector3.new(0, 1, 0)
        billboard.AlwaysOnTop = true

        local label = Instance.new("TextLabel")
        label.Parent = billboard
        label.BackgroundTransparency = 1
        label.Position = UDim2.new(0, 0, 0, -50)
        label.Size = UDim2.new(0, 100, 0, 100)
        label.Font = Enum.Font.SourceSansSemibold
        label.TextSize = self.TextSize
        label.TextColor3 = self.TextColor
        label.TextStrokeTransparency = self.TextStroke and 0 or 1
        label.TextYAlignment = Enum.TextYAlignment.Bottom
        label.Text = "Name: " .. plr.Name
        label.ZIndex = 10

        local loopConnection
        local addedConnection
        local removedConnection

        local function updateText()
            if not holder.Parent then return end
            local char = plr.Character
            local localChar = TextLocalPlayer.Character
            if char and textGetRoot(char) and char:FindFirstChildOfClass("Humanoid") and localChar and textGetRoot(localChar) and localChar:FindFirstChildOfClass("Humanoid") then
                local dist = math.floor((textGetRoot(localChar).Position - textGetRoot(char).Position).Magnitude)
                local health = textRound(char:FindFirstChildOfClass("Humanoid").Health, 1)
                local parts = {}
                if self.ShowName then table.insert(parts, "Name: " .. plr.Name) end
                if self.ShowHealth then table.insert(parts, "Health: " .. health) end
                if self.ShowDistance then table.insert(parts, "Studs: " .. dist) end
                label.Text = table.concat(parts, " | ")
            end
        end

        loopConnection = TextRunService.RenderStepped:Connect(updateText)

        addedConnection = plr.CharacterAdded:Connect(function(newChar)
            if loopConnection then loopConnection:Disconnect() end
            if addedConnection then addedConnection:Disconnect() end
            if holder then holder:Destroy() end
            self.Folder[plr] = nil
            repeat task.wait() until newChar and textGetRoot(newChar) and newChar:FindFirstChildOfClass("Humanoid")
            self:CreateForPlayer(plr)
        end)

        removedConnection = plr.AncestryChanged:Connect(function()
            if not plr.Parent then
                if loopConnection then loopConnection:Disconnect() end
                if addedConnection then addedConnection:Disconnect() end
                if removedConnection then removedConnection:Disconnect() end
                if holder then holder:Destroy() end
                self.Folder[plr] = nil
            end
        end)
    end)
end

function TextESP:RemoveForPlayer(plr)
    if self.Folder[plr] then
        self.Folder[plr]:Destroy()
        self.Folder[plr] = nil
    end
end

function TextESP:Start()
    if self.Enabled then return end
    self.Enabled = true

    for _, plr in ipairs(TextPlayers:GetPlayers()) do
        if plr ~= TextLocalPlayer then
            self:CreateForPlayer(plr)
        end
    end

    self.PlayerAddedConn = TextPlayers.PlayerAdded:Connect(function(plr)
        plr.CharacterAdded:Connect(function()
            self:CreateForPlayer(plr)
        end)
    end)

    self.PlayerRemovingConn = TextPlayers.PlayerRemoving:Connect(function(plr)
        self:RemoveForPlayer(plr)
    end)
end

function TextESP:Stop()
    if not self.Enabled then return end
    self.Enabled = false

    if self.PlayerAddedConn then
        self.PlayerAddedConn:Disconnect()
        self.PlayerAddedConn = nil
    end
    if self.PlayerRemovingConn then
        self.PlayerRemovingConn:Disconnect()
        self.PlayerRemovingConn = nil
    end

    for plr, folder in pairs(self.Folder) do
        if folder then folder:Destroy() end
    end
    self.Folder = {}
end

function TextESP:Destroy()
    self:Stop()
end

-- ===== DRAWING ESP ===== --
local DrawingESP = {}
DrawingESP.__index = DrawingESP

local DrawPlayers = game:GetService("Players")
local DrawRunService = game:GetService("RunService")
local DrawCamera = workspace.CurrentCamera
local DrawLocalPlayer = DrawPlayers.LocalPlayer

local bodyConnections = {
    R15 = {
        {"Head", "UpperTorso"},
        {"UpperTorso", "LowerTorso"},
        {"LowerTorso", "LeftUpperLeg"},
        {"LowerTorso", "RightUpperLeg"},
        {"LeftUpperLeg", "LeftLowerLeg"},
        {"LeftLowerLeg", "LeftFoot"},
        {"RightUpperLeg", "RightLowerLeg"},
        {"RightLowerLeg", "RightFoot"},
        {"UpperTorso", "LeftUpperArm"},
        {"UpperTorso", "RightUpperArm"},
        {"LeftUpperArm", "LeftLowerArm"},
        {"LeftLowerArm", "LeftHand"},
        {"RightUpperArm", "RightLowerArm"},
        {"RightLowerArm", "RightHand"}
    },
    R6 = {
        {"Head", "Torso"},
        {"Torso", "Left Arm"},
        {"Torso", "Right Arm"},
        {"Torso", "Left Leg"},
        {"Torso", "Right Leg"}
    }
}

function DrawingESP.new(settings)
    settings = settings or {}
    local self = setmetatable({}, DrawingESP)
    self.Enabled = false
    self.espCache = {}
    self.ShowBox = settings.ShowBox ~= false
    self.ShowHealth = settings.ShowHealth ~= false
    self.ShowSkeleton = settings.ShowSkeleton ~= false
    self.BoxColor = settings.BoxColor or Color3.fromRGB(255, 255, 255)
    self.HealthColor = settings.HealthColor or Color3.fromRGB(0, 255, 0)
    self.SkeletonColor = settings.SkeletonColor or Color3.fromRGB(255, 255, 255)
    self.LoopConnection = nil
    return self
end

function DrawingESP:createDrawing(drawingType, properties)
    local drawing = Drawing.new(drawingType)
    for prop, val in pairs(properties) do
        drawing[prop] = val
    end
    return drawing
end

function DrawingESP:createComponents()
    return {
        Box = self:createDrawing("Square", {
            Thickness = 1,
            Transparency = 1,
            Color = self.BoxColor,
            Filled = false
        }),
        HealthBar = {
            Outline = self:createDrawing("Square", {
                Thickness = 1,
                Transparency = 1,
                Color = Color3.fromRGB(0, 0, 0),
                Filled = false
            }),
            Health = self:createDrawing("Square", {
                Thickness = 1,
                Transparency = 1,
                Color = self.HealthColor,
                Filled = true
            })
        },
        SkeletonLines = {}
    }
end

function DrawingESP:updateComponents(components, character, player)
    local hrp = character:FindFirstChild("HumanoidRootPart")
    local humanoid = character:FindFirstChild("Humanoid")

    if hrp and humanoid then
        local hrpPosition, onScreen = DrawCamera:WorldToViewportPoint(hrp.Position)

        if onScreen then
            local screenWidth, screenHeight = DrawCamera.ViewportSize.X, DrawCamera.ViewportSize.Y
            local factor = 1 / (hrpPosition.Z * math.tan(math.rad(DrawCamera.FieldOfView * 0.5)) * 2) * 100
            local width, height = math.floor(screenHeight / 20 * factor), math.floor(screenWidth / 30 * factor)

            components.Box.Size = Vector2.new(width, height)
            components.Box.Position = Vector2.new(hrpPosition.X - width / 2, hrpPosition.Y - height / 2)
            components.Box.Color = self.BoxColor
            components.Box.Visible = self.ShowBox

            local healthBarHeight = height
            local healthBarWidth = 5
            local healthFraction = humanoid.Health / humanoid.MaxHealth

            components.HealthBar.Outline.Size = Vector2.new(healthBarWidth, healthBarHeight)
            components.HealthBar.Outline.Position = Vector2.new(components.Box.Position.X - healthBarWidth - 2, components.Box.Position.Y)
            components.HealthBar.Outline.Visible = self.ShowHealth

            components.HealthBar.Health.Size = Vector2.new(healthBarWidth - 2, healthBarHeight * healthFraction)
            components.HealthBar.Health.Position = Vector2.new(components.HealthBar.Outline.Position.X + 1, components.HealthBar.Outline.Position.Y + healthBarHeight * (1 - healthFraction))
            components.HealthBar.Health.Color = self.HealthColor
            components.HealthBar.Health.Visible = self.ShowHealth

            local connections = bodyConnections[humanoid.RigType.Name] or {}
            local activeKeys = {}
            for _, connection in ipairs(connections) do
                local key = connection[1] .. "-" .. connection[2]
                activeKeys[key] = true
                local partA = character:FindFirstChild(connection[1])
                local partB = character:FindFirstChild(connection[2])
                if partA and partB then
                    local line = components.SkeletonLines[key]
                    if not line then
                        line = self:createDrawing("Line", {Thickness = 1, Color = self.SkeletonColor})
                        components.SkeletonLines[key] = line
                    end
                    local posA, onScreenA = DrawCamera:WorldToViewportPoint(partA.Position)
                    local posB, onScreenB = DrawCamera:WorldToViewportPoint(partB.Position)
                    if onScreenA and onScreenB and self.ShowSkeleton then
                        line.From = Vector2.new(posA.X, posA.Y)
                        line.To = Vector2.new(posB.X, posB.Y)
                        line.Color = self.SkeletonColor
                        line.Visible = true
                    else
                        line.Visible = false
                    end
                end
            end
            for key, line in pairs(components.SkeletonLines) do
                if not activeKeys[key] then line.Visible = false end
            end
        else
            self:hideComponents(components)
        end
    else
        self:hideComponents(components)
    end
end

function DrawingESP:hideComponents(components)
    components.Box.Visible = false
    components.HealthBar.Outline.Visible = false
    components.HealthBar.Health.Visible = false
    for _, line in pairs(components.SkeletonLines) do
        line.Visible = false
    end
end

function DrawingESP:removeEsp(player)
    local components = self.espCache[player]
    if components then
        components.Box:Remove()
        components.HealthBar.Outline:Remove()
        components.HealthBar.Health:Remove()
        for _, line in pairs(components.SkeletonLines) do
            line:Remove()
        end
        self.espCache[player] = nil
    end
end

function DrawingESP:Start()
    if self.Enabled then return end
    self.Enabled = true

    self.LoopConnection = DrawRunService.RenderStepped:Connect(function()
        for _, player in ipairs(DrawPlayers:GetPlayers()) do
            if player ~= DrawLocalPlayer then
                local character = player.Character
                if character then
                    if not self.espCache[player] then
                        self.espCache[player] = self:createComponents()
                    end
                    self:updateComponents(self.espCache[player], character, player)
                else
                    if self.espCache[player] then
                        self:hideComponents(self.espCache[player])
                    end
                end
            end
        end
    end)

    DrawPlayers.PlayerRemoving:Connect(function(player)
        self:removeEsp(player)
    end)
end

function DrawingESP:Stop()
    if not self.Enabled then return end
    self.Enabled = false

    if self.LoopConnection then
        self.LoopConnection:Disconnect()
        self.LoopConnection = nil
    end

    for _, components in pairs(self.espCache) do
        components.Box:Remove()
        components.HealthBar.Outline:Remove()
        components.HealthBar.Health:Remove()
        for _, line in pairs(components.SkeletonLines) do
            line:Remove()
        end
    end
    self.espCache = {}
end

function DrawingESP:Destroy()
    self:Stop()
end

-- ===== PACKAGE ===== --
return {
    Text = TextESP,
    Drawing = DrawingESP
}
