-- ===== ESP MODULE ===== --
local ESP = {}
ESP.__index = ESP

local Players = game:GetService("Players")
local RunService = game:GetService("RunService")
local LocalPlayer = Players.LocalPlayer

local function round(num, places)
    local mult = 10 ^ (places or 0)
    return math.floor(num * mult + 0.5) / mult
end

local function num(v, default)
    local n = tonumber(v)
    if n == nil then return default end
    return n
end

local bodyConnections = {
    R15 = {
        {"Head", "UpperTorso"},
        {"UpperTorso", "LowerTorso"},
        {"LowerTorso", "LeftUpperLeg"},
        {"LowerTorso", "RightUpperLeg"},
        {"LeftUpperLeg", "LeftLowerLeg"},
        {"LeftLowerLeg", "LeftFoot"},
        {"RightUpperLeg", "RightLowerLeg"},
        {"RightLowerLeg", "RightFoot"},
        {"UpperTorso", "LeftUpperArm"},
        {"UpperTorso", "RightUpperArm"},
        {"LeftUpperArm", "LeftLowerArm"},
        {"LeftLowerArm", "LeftHand"},
        {"RightUpperArm", "RightLowerArm"},
        {"RightLowerArm", "RightHand"}
    },
    R6 = {
        {"Head", "Torso"},
        {"Torso", "Left Arm"},
        {"Torso", "Right Arm"},
        {"Torso", "Left Leg"},
        {"Torso", "Right Leg"}
    }
}

-- ===== CONSTRUCTOR ===== --
function ESP.new(settings)
    settings = settings or {}
    local self = setmetatable({}, ESP)

    self.Enabled = settings.Enabled or false
    self.TextESPEnabled = settings.TextESPEnabled ~= false
    self.BoxESPEnabled = settings.BoxESPEnabled ~= false
    self.HealthESPEnabled = settings.HealthESPEnabled ~= false
    self.SkeletonESPEnabled = settings.SkeletonESPEnabled ~= false

    self.TextColor = settings.TextColor or Color3.new(1, 1, 1)
    self.TextSize = math.max(1, num(settings.TextSize, 20))
    self.TextTransparency = math.clamp(num(settings.TextTransparency, 0), 0, 1)
    self.TextStroke = settings.TextStroke ~= false
    self.TextStrokeTransparency = math.clamp(num(settings.TextStrokeTransparency, 0), 0, 1)
    self.ShowName = settings.ShowName ~= false
    self.ShowHealth = settings.ShowHealth ~= false
    self.ShowDistance = settings.ShowDistance ~= false

    self.BoxColor = settings.BoxColor or Color3.new(1, 1, 1)
    self.BoxThickness = math.max(1, num(settings.BoxThickness, 1))
    self.BoxTransparency = math.clamp(num(settings.BoxTransparency, 0), 0, 1)
    self.BoxFilled = settings.BoxFilled or false
    self.BoxFillTransparency = math.clamp(num(settings.BoxFillTransparency, 0.5), 0, 1)

    self.HealthColor = settings.HealthColor or Color3.new(0, 1, 0)
    self.LowHealthColor = settings.LowHealthColor or Color3.new(1, 0, 0)
    self.HealthTransparency = math.clamp(num(settings.HealthTransparency, 0), 0, 1)
    self.HealthBarWidth = math.max(1, num(settings.HealthBarWidth, 5))
    self.HealthBarPosition = settings.HealthBarPosition or "Left"
    self.HealthBarOffset = num(settings.HealthBarOffset, 2)

    self.SkeletonColor = settings.SkeletonColor or Color3.new(1, 1, 1)
    self.SkeletonThickness = math.max(1, num(settings.SkeletonThickness, 1))
    self.SkeletonTransparency = math.clamp(num(settings.SkeletonTransparency, 0), 0, 1)

    self.MaxDistance = tonumber(settings.MaxDistance) or nil
    self.MaxEntities = tonumber(settings.MaxEntities) or nil
    self.UpdateRate = math.max(1, num(settings.UpdateRate, 1))
    self.VisibleOnly = settings.VisibleOnly or false
    self.RainbowEnabled = settings.RainbowEnabled or false
    self.RainbowSpeed = num(settings.RainbowSpeed, 1)

    self.Sources = {}
    self.Cache = {}
    self.FrameCounter = 0
    self.LoopConnection = nil
    self._rainbow = Color3.new(1, 1, 1)

    return self
end

-- ===== COLORS ===== --
function ESP:ApplyRainbow()
    if not self.RainbowEnabled then return end
    local hue = (os.clock() * self.RainbowSpeed) % 1
    self._rainbow = Color3.fromHSV(hue, 1, 1)
end

function ESP:BoxDrawColor()
    return self.RainbowEnabled and self._rainbow or self.BoxColor
end

function ESP:SkeletonDrawColor()
    return self.RainbowEnabled and self._rainbow or self.SkeletonColor
end

function ESP:TextDrawColor()
    return self.RainbowEnabled and self._rainbow or self.TextColor
end

function ESP:HealthDrawColor(frac)
    local baseColor = self.RainbowEnabled and self._rainbow or self.HealthColor
    if frac < 0.3 then return self.LowHealthColor end
    if frac < 0.6 then
        local t = (frac - 0.3) / 0.3
        return baseColor:Lerp(self.LowHealthColor, 1 - t)
    end
    return baseColor
end

-- ===== SOURCES ===== --
function ESP:AddSource(name, getter, isPlayer, startEnabled, nonHumanoid)
    self.Sources[name] = {
        Enabled = startEnabled ~= false,
        Getter = getter,
        IsPlayer = isPlayer or false,
        NonHumanoid = nonHumanoid or false
    }
end

function ESP:SetSourceEnabled(name, enabled)
    if self.Sources[name] then
        self.Sources[name].Enabled = enabled
    end
end

-- ===== HELPERS ===== --
function ESP:GetRoot(model)
    if not model then return nil end
    if model:IsA("BasePart") then return model end
    return model:FindFirstChild("HumanoidRootPart")
        or model:FindFirstChild("Torso")
        or model:FindFirstChild("Head")
        or model:FindFirstChildWhichIsA("BasePart")
end

function ESP:GetHead(model)
    if not model then return nil end
    if model:IsA("BasePart") then return model end
    return model:FindFirstChild("Head") or self:GetRoot(model)
end

function ESP:IsVisible(part, camPos)
    if not part or not part.Parent then return false end
    local pos = part.Position
    local diff = pos - camPos
    local dist = diff.Magnitude
    if dist < 0.01 then return true end
    local ray = Ray.new(camPos, diff.Unit * dist)
    local camera = workspace.CurrentCamera
    local ignore = {LocalPlayer.Character, camera}
    local hit = workspace:FindPartOnRayWithIgnoreList(ray, ignore, false, true)
    if not hit then return false end
    local character = part
    while character and not character:IsA("Model") do character = character.Parent end
    return character ~= nil and hit:IsDescendantOf(character)
end

function ESP:BuildList()
    local list = {}
    local camera = workspace.CurrentCamera
    if not camera then return list end
    local camPos = camera.CFrame.Position
    local localChar = LocalPlayer.Character
    local seen = {}

    for srcName, src in pairs(self.Sources) do
        if src.Enabled then
            local ok, entities = pcall(src.Getter)
            if ok and entities then
                for _, entity in ipairs(entities) do
                    local model, playerObj
                    if typeof(entity) == "Instance" then
                        if entity:IsA("Player") then
                            playerObj = entity
                            model = entity.Character
                        elseif entity:IsA("BasePart") then
                            model = entity
                        elseif entity:IsA("Model") then
                            model = entity
                        end
                    end

                    if model and model ~= localChar and model.Parent and not seen[model] then
                        local hum = model:FindFirstChildOfClass("Humanoid")
                        local root = self:GetRoot(model)

                        local accepted = false
                        if hum and hum.Health > 0 and root then
                            accepted = true
                        elseif src.NonHumanoid and root then
                            accepted = true
                        end

                        if accepted then
                            local dist = (camPos - root.Position).Magnitude
                            if not self.MaxDistance or dist <= self.MaxDistance then
                                if not self.VisibleOnly or self:IsVisible(root, camPos) then
                                    seen[model] = true
                                    table.insert(list, {
                                        Model = model,
                                        Player = playerObj,
                                        Root = root,
                                        Distance = dist,
                                        SourceName = srcName,
                                        NonHumanoid = src.NonHumanoid,
                                    })
                                end
                            end
                        end
                    end
                end
            end
        end
    end

    table.sort(list, function(a, b) return a.Distance < b.Distance end)
    if self.MaxEntities and #list > self.MaxEntities then
        for i = self.MaxEntities + 1, #list do list[i] = nil end
    end
    return list
end

function ESP:GetKey(entry)
    if entry.Player then return "P_" .. entry.Player.Name end
    local id = 0
    pcall(function() id = entry.Model:GetDebugId() end)
    return "M_" .. entry.Model.Name .. "_" .. tostring(id)
end

-- ===== BOX SIZING ===== --
function ESP:GetBoxRect(entry)
    local model = entry.Model
    local root = entry.Root
    if not model or not model.Parent or not root or not root.Parent then return nil end

    local camera = workspace.CurrentCamera
    if not camera then return nil end

    local head = model:FindFirstChild("Head")
    local humanoid = model:FindFirstChildOfClass("Humanoid")

    local topWorld, bottomWorld

    if head and humanoid then
        topWorld = head.Position + Vector3.new(0, head.Size.Y * 0.5, 0)

        local bottomY = root.Position.Y - root.Size.Y * 0.5
        local lowerParts = {
            "LeftFoot", "RightFoot",
            "LeftLowerLeg", "RightLowerLeg",
            "LeftUpperLeg", "RightUpperLeg",
            "Left Leg", "Right Leg"
        }
        for _, name in ipairs(lowerParts) do
            local part = model:FindFirstChild(name)
            if part then
                local pb = part.Position.Y - part.Size.Y * 0.5
                if pb < bottomY then bottomY = pb end
            end
        end
        bottomWorld = Vector3.new(root.Position.X, bottomY, root.Position.Z)
    elseif model:IsA("BasePart") then
        local size = model.Size
        if size.Magnitude == 0 then return nil end
        topWorld = model.Position + Vector3.new(0, size.Y * 0.5, 0)
        bottomWorld = model.Position - Vector3.new(0, size.Y * 0.5, 0)
    elseif model:IsA("Model") then
        local cf, size = model:GetBoundingBox()
        if size.Magnitude == 0 then return nil end
        topWorld = cf.Position + Vector3.new(0, size.Y * 0.5, 0)
        bottomWorld = cf.Position - Vector3.new(0, size.Y * 0.5, 0)
    else
        return nil
    end

    local topScreen, topOn = camera:WorldToViewportPoint(topWorld)
    local bottomScreen, bottomOn = camera:WorldToViewportPoint(bottomWorld)
    if not topOn or not bottomOn then return nil end

    local height = math.abs(bottomScreen.Y - topScreen.Y)
    if height < 1 then return nil end

    local width = height * 0.55

    local centerX = (topScreen.X + bottomScreen.X) * 0.5
    local centerY = (topScreen.Y + bottomScreen.Y) * 0.5

    return {
        Position = Vector2.new(centerX - width * 0.5, centerY - height * 0.5),
        Size = Vector2.new(width, height),
        Center = Vector2.new(centerX, centerY),
        ScreenPos = topScreen
    }
end

-- ===== TEXT ===== --
function ESP:CreateText(entry)
    local head = self:GetHead(entry.Model)
    if not head or not head.Parent then return nil end

    local holder = Instance.new("Folder")
    holder.Name = entry.Model.Name .. "_ESP"
    holder.Parent = LocalPlayer:WaitForChild("PlayerGui")

    local billboard = Instance.new("BillboardGui")
    billboard.Name = entry.Model.Name
    billboard.Parent = holder
    billboard.Size = UDim2.new(0, 100, 0, 150)
    billboard.StudsOffset = Vector3.new(0, 1, 0)
    billboard.AlwaysOnTop = true

    local label = Instance.new("TextLabel")
    label.Parent = billboard
    label.BackgroundTransparency = 1
    label.Position = UDim2.new(0, 0, 0, -50)
    label.Size = UDim2.new(0, 100, 0, 100)
    label.Font = Enum.Font.SourceSansSemibold
    label.TextSize = self.TextSize
    label.TextColor3 = self:TextDrawColor()
    label.TextTransparency = self.TextTransparency
    label.TextStrokeTransparency = self.TextStroke and self.TextStrokeTransparency or 1
    label.TextYAlignment = Enum.TextYAlignment.Bottom
    label.Text = entry.Model.Name
    label.ZIndex = 10

    pcall(function() billboard.Adornee = head end)

    return {Holder = holder, Label = label, Billboard = billboard}
end

function ESP:UpdateText(data, entry)
    if not data or not data.Label then return end
    if not data.Holder or not data.Holder.Parent then return end

    local adornee = data.Billboard and data.Billboard.Adornee
    if not adornee or not adornee.Parent then return end

    local hum = entry.Model:FindFirstChildOfClass("Humanoid")
    local localRoot = LocalPlayer.Character and self:GetRoot(LocalPlayer.Character)
    if not localRoot then return end

    local dist = math.floor((localRoot.Position - entry.Root.Position).Magnitude)
    local name = entry.Player and entry.Player.Name or entry.Model.Name

    local parts = {}
    if self.ShowName then table.insert(parts, "Name: " .. name) end
    if self.ShowHealth and hum then
        table.insert(parts, "Health: " .. round(hum.Health, 1))
    end
    if self.ShowDistance then table.insert(parts, "Studs: " .. dist) end

    data.Label.Text = table.concat(parts, " | ")
    data.Label.TextColor3 = self:TextDrawColor()
    data.Label.TextSize = self.TextSize
    data.Label.TextTransparency = self.TextTransparency
    data.Label.TextStrokeTransparency = self.TextStroke and self.TextStrokeTransparency or 1
end

function ESP:DestroyText(data)
    if data and data.Holder then data.Holder:Destroy() end
end

-- ===== BOX ===== --
function ESP:CreateBox()
    local outline = Drawing.new("Square")
    outline.Thickness = self.BoxThickness
    outline.Transparency = 1 - self.BoxTransparency
    outline.Color = self:BoxDrawColor()
    outline.Filled = false
    outline.Visible = false

    local fill = Drawing.new("Square")
    fill.Thickness = 0
    fill.Transparency = 1 - self.BoxFillTransparency
    fill.Color = self:BoxDrawColor()
    fill.Filled = true
    fill.Visible = false

    return {Outline = outline, Fill = fill}
end

function ESP:UpdateBox(data, entry)
    local rect = self:GetBoxRect(entry)
    if not rect then
        data.Outline.Visible = false
        data.Fill.Visible = false
        return
    end

    local color = self:BoxDrawColor()

    data.Outline.Size = rect.Size
    data.Outline.Position = rect.Position
    data.Outline.Color = color
    data.Outline.Thickness = self.BoxThickness
    data.Outline.Transparency = 1 - self.BoxTransparency
    data.Outline.Visible = true

    if self.BoxFilled then
        data.Fill.Size = rect.Size
        data.Fill.Position = rect.Position
        data.Fill.Color = color
        data.Fill.Transparency = 1 - self.BoxFillTransparency
        data.Fill.Visible = true
    else
        data.Fill.Visible = false
    end
end

function ESP:DestroyBox(data)
    if not data then return end
    if data.Outline then data.Outline:Remove() end
    if data.Fill then data.Fill:Remove() end
end

-- ===== HEALTH ===== --
function ESP:CreateHealth()
    return {
        Outline = Drawing.new("Square"),
        Fill = Drawing.new("Square")
    }
end

function ESP:UpdateHealth(data, entry, rect)
    local hum = entry.Model:FindFirstChildOfClass("Humanoid")
    if not hum then
        data.Outline.Visible = false
        data.Fill.Visible = false
        return
    end

    local frac = math.clamp(hum.Health / math.max(hum.MaxHealth, 1), 0, 1)
    local color = self:HealthDrawColor(frac)
    local alpha = 1 - self.HealthTransparency

    local pos = self.HealthBarPosition
    local ox = self.HealthBarOffset
    local bw = self.HealthBarWidth
    local x, y, w, h

    if pos == "Right" then
        w = bw
        h = rect.Size.Y
        x = rect.Position.X + rect.Size.X + ox
        y = rect.Position.Y
    elseif pos == "Top" then
        w = rect.Size.X
        h = 6
        x = rect.Position.X
        y = rect.Position.Y - ox - h
    elseif pos == "Bottom" then
        w = rect.Size.X
        h = 6
        x = rect.Position.X
        y = rect.Position.Y + rect.Size.Y + ox
    else
        w = bw
        h = rect.Size.Y
        x = rect.Position.X - bw - ox
        y = rect.Position.Y
    end

    data.Outline.Size = Vector2.new(w, h)
    data.Outline.Position = Vector2.new(x, y)
    data.Outline.Color = Color3.new(0, 0, 0)
    data.Outline.Filled = true
    data.Outline.Transparency = alpha
    data.Outline.Visible = true

    if pos == "Top" or pos == "Bottom" then
        data.Fill.Size = Vector2.new(math.max((w - 2) * frac, 0), math.max(h - 2, 0))
        data.Fill.Position = Vector2.new(x + 1, y + 1)
    else
        data.Fill.Size = Vector2.new(math.max(w - 2, 0), math.max((h - 2) * frac, 0))
        data.Fill.Position = Vector2.new(x + 1, y + 1 + (h - 2) * (1 - frac))
    end

    data.Fill.Color = color
    data.Fill.Filled = true
    data.Fill.Transparency = alpha
    data.Fill.Visible = true
end

function ESP:DestroyHealth(data)
    if not data then return end
    if data.Outline then data.Outline:Remove() end
    if data.Fill then data.Fill:Remove() end
end

-- ===== SKELETON ===== --
function ESP:CreateSkeleton()
    return {Lines = {}, Rig = nil}
end

function ESP:UpdateSkeleton(data, entry)
    local hum = entry.Model:FindFirstChildOfClass("Humanoid")
    if not hum then
        for _, line in pairs(data.Lines) do line.Visible = false end
        return
    end

    local camera = workspace.CurrentCamera
    if not camera then
        for _, line in pairs(data.Lines) do line.Visible = false end
        return
    end

    local rig = hum.RigType.Name
    if data.Rig ~= rig then
        for _, line in pairs(data.Lines) do line:Remove() end
        data.Lines = {}
        data.Rig = rig
    end

    local conns = bodyConnections[rig] or bodyConnections.R15
    local activeKeys = {}
    local alpha = 1 - self.SkeletonTransparency

    for _, connection in ipairs(conns) do
        local key = connection[1] .. "-" .. connection[2]
        activeKeys[key] = true

        if not data.Lines[key] then
            local line = Drawing.new("Line")
            line.Thickness = self.SkeletonThickness
            line.Transparency = alpha
            line.Color = self:SkeletonDrawColor()
            line.Visible = false
            data.Lines[key] = line
        end

        local line = data.Lines[key]
        local partA = entry.Model:FindFirstChild(connection[1])
        local partB = entry.Model:FindFirstChild(connection[2])

        if partA and partB then
            local posA, onA = camera:WorldToViewportPoint(partA.Position)
            local posB, onB = camera:WorldToViewportPoint(partB.Position)
            if onA and onB then
                line.From = Vector2.new(posA.X, posA.Y)
                line.To = Vector2.new(posB.X, posB.Y)
                line.Color = self:SkeletonDrawColor()
                line.Transparency = alpha
                line.Thickness = self.SkeletonThickness
                line.Visible = true
            else
                line.Visible = false
            end
        else
            line.Visible = false
        end
    end

    for key, line in pairs(data.Lines) do
        if not activeKeys[key] then line.Visible = false end
    end
end

function ESP:DestroySkeleton(data)
    if not data then return end
    for _, line in pairs(data.Lines) do line:Remove() end
end

-- ===== ENTRY ===== --
function ESP:DestroyEntry(data)
    self:DestroyText(data.Text)
    self:DestroyBox(data.Box)
    self:DestroyHealth(data.Health)
    self:DestroySkeleton(data.Skeleton)
end

-- ===== MAIN LOOP ===== --
function ESP:Step()
    self.FrameCounter = self.FrameCounter + 1
    if self.FrameCounter % self.UpdateRate ~= 0 then return end
    if not self.Enabled then return end

    self:ApplyRainbow()

    local list = self:BuildList()
    local active = {}

    for _, entry in ipairs(list) do
        local key = self:GetKey(entry)
        active[key] = true

        local data = self.Cache[key]
        if not data or data.Model ~= entry.Model then
            if data then self:DestroyEntry(data) end
            data = { Model = entry.Model }
            self.Cache[key] = data
        end

        local isObject = entry.NonHumanoid == true

        if self.TextESPEnabled then
            if data.Text then
                local adornee = data.Text.Billboard and data.Text.Billboard.Adornee
                if not data.Text.Holder or not data.Text.Holder.Parent or not adornee or not adornee.Parent then
                    self:DestroyText(data.Text)
                    data.Text = nil
                end
            end
            if not data.Text then
                data.Text = self:CreateText(entry)
            end
        else
            if data.Text then
                self:DestroyText(data.Text)
                data.Text = nil
            end
        end

        if self.BoxESPEnabled and not isObject then
            if not data.Box then data.Box = self:CreateBox() end
        else
            if data.Box then
                self:DestroyBox(data.Box)
                data.Box = nil
            end
        end

        if self.HealthESPEnabled and not isObject then
            if not data.Health then data.Health = self:CreateHealth() end
        else
            if data.Health then
                self:DestroyHealth(data.Health)
                data.Health = nil
            end
        end

        if self.SkeletonESPEnabled and not isObject then
            if not data.Skeleton then data.Skeleton = self:CreateSkeleton() end
        else
            if data.Skeleton then
                self:DestroySkeleton(data.Skeleton)
                data.Skeleton = nil
            end
        end

        local rect = (not isObject) and self:GetBoxRect(entry) or nil

        if data.Text then
            self:UpdateText(data.Text, entry)
        end

        if data.Box then
            self:UpdateBox(data.Box, entry)
        end

        if data.Health then
            if rect then
                self:UpdateHealth(data.Health, entry, rect)
            else
                data.Health.Outline.Visible = false
                data.Health.Fill.Visible = false
            end
        end

        if data.Skeleton then
            self:UpdateSkeleton(data.Skeleton, entry)
        end
    end

    for key, data in pairs(self.Cache) do
        if not active[key] then
            self:DestroyEntry(data)
            self.Cache[key] = nil
        end
    end
end

function ESP:Start()
    if self.LoopConnection then return end
    self._bindName = "ESP_Update_" .. tostring(math.random(1, 1000000))
    RunService:BindToRenderStep(self._bindName, Enum.RenderPriority.Camera.Value + 200, function()
        self:Step()
    end)
    self.LoopConnection = true
end

function ESP:Stop()
    if self._bindName then
        pcall(function()
            RunService:UnbindFromRenderStep(self._bindName)
        end)
        self._bindName = nil
    end
    self.LoopConnection = nil
    for _, data in pairs(self.Cache) do
        self:DestroyEntry(data)
    end
    self.Cache = {}
end
function ESP:SetEnabled(state)
    self.Enabled = state
    if state then
        self:Start()
    else
        self:Stop()
    end
end

function ESP:Destroy()
    self:Stop()
end

return ESP
