-- ===== auto shoot ===== --
task.spawn(function()
    while task.wait(0.15) do
        if not AutoShoot or not canFire() then continue end

        local char = LP.Character
        local hrp = char and char:FindFirstChild("HumanoidRootPart")
        if not hrp then continue end

        local origin = hrp.Position
        local fired = false

        if NoCooldown then
            for _, model in ipairs(workspace:GetChildren()) do
                if not model:IsA("Model") or not isEnemy(model, char) then continue end
                local part = getPart(model, true, origin, {char, model})
                if not part then continue end
                Remote:FireServer(origin, part.Position, part, part.Position)
                fired = true
            end
        else
            local bestPart, bestDist = nil, math.huge
            for _, model in ipairs(workspace:GetChildren()) do
                if not model:IsA("Model") or not isEnemy(model, char) then continue end
                local part = getPart(model, true, origin, {char, model})
                if not part then continue end
                local dist = (origin - part.Position).Magnitude
                if dist < bestDist then
                    bestDist = dist
                    bestPart = part
                end
            end
            if bestPart then
                Remote:FireServer(origin, bestPart.Position, bestPart, bestPart.Position)
                fired = true
            end
        end

        if fired then markShot() end
    end
end)

-- ===== kill all ===== --
local equipCounter = 0
RunService.RenderStepped:Connect(function()
    if not KillAll then return end

    equipCounter = equipCounter + 1
    if equipCounter >= 9 then
        equipCounter = 0
        equipAll()
    end

    local char = LP.Character
    local hrp = char and char:FindFirstChild("HumanoidRootPart")
    if not hrp then return end

    local origin = hrp.Position
    for _, model in ipairs(workspace:GetChildren()) do
        if not model:IsA("Model") or not isEnemy(model, char) then continue end
        local part = getPart(model, false)
        if not part then continue end
        Remote:FireServer(origin, part.Position, part, part.Position)
    end
end)

