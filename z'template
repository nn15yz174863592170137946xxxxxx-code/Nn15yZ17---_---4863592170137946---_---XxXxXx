local bodyConnections = {
    R15 = {
        {"Head", "UpperTorso"},
        {"UpperTorso", "LowerTorso"},
        {"LowerTorso", "LeftUpperLeg"},
        {"LowerTorso", "RightUpperLeg"},
        {"LeftUpperLeg", "LeftLowerLeg"},
        {"LeftLowerLeg", "LeftFoot"},
        {"RightUpperLeg", "RightLowerLeg"},
        {"RightLowerLeg", "RightFoot"},
        {"UpperTorso", "LeftUpperArm"},
        {"UpperTorso", "RightUpperArm"},
        {"LeftUpperArm", "LeftLowerArm"},
        {"LeftLowerArm", "LeftHand"},
        {"RightUpperArm", "RightLowerArm"},
        {"RightLowerArm", "RightHand"}
    },
    R6 = {
        {"Head", "Torso"},
        {"Torso", "Left Arm"},
        {"Torso", "Right Arm"},
        {"Torso", "Left Leg"},
        {"Torso", "Right Leg"}
    }
}

function ESP:CreateSkeletonESP()
    local lines = {}
    for _, conn in ipairs(bodyConnections.R15) do
        local line = Drawing.new("Line")
        line.Thickness = self.SkeletonThickness
        line.Transparency = self.SkeletonTransparency
        line.Color = self.SkeletonColor
        line.Visible = false
        table.insert(lines, {line = line, conn = conn})
    end
    return lines
end

function ESP:UpdateSkeletonESP(skeletonLines, entity)
    local humanoid = entity:FindFirstChild("Humanoid")
    if not humanoid then
        for _, data in ipairs(skeletonLines) do
            data.line.Visible = false
        end
        return
    end

    local connections = bodyConnections[humanoid.RigType.Name] or bodyConnections.R15

    for i, data in ipairs(skeletonLines) do
        local conn = connections[i] or data.conn
        if not conn then
            data.line.Visible = false
            continue
        end

        local partA = entity:FindFirstChild(conn[1])
        local partB = entity:FindFirstChild(conn[2])

        if partA and partB then
            local posA, onScreenA = self.Camera:WorldToViewportPoint(partA.Position)
            local posB, onScreenB = self.Camera:WorldToViewportPoint(partB.Position)

            if onScreenA and onScreenB then
                data.line.From = Vector2.new(posA.X, posA.Y)
                data.line.To = Vector2.new(posB.X, posB.Y)
                data.line.Visible = true
            else
                data.line.Visible = false
            end
        else
            data.line.Visible = false
        end
    end
end

function ESP:DestroySkeletonESP(skeletonLines)
    for _, data in ipairs(skeletonLines) do
        if data.line then data.line:Remove() end
    end
end

function ESP:UpdateSkeletonESPConfig()
    for _, skeletonLines in pairs(self.SkeletonESPObjects) do
        for _, data in ipairs(skeletonLines) do
            if data.line then
                data.line.Thickness = self.SkeletonThickness
                data.line.Transparency = self.SkeletonTransparency
                data.line.Color = self.SkeletonColor
            end
        end
    end
end

-- ==========================================
-- ===== MAIN ESP LOOP =====
-- ==========================================

function ESP:Start()
    if self.ESPLoopConnection then return end

    self.ESPLoopConnection = game:GetService("RunService").RenderStepped:Connect(function()
        self.FrameCounter = self.FrameCounter + 1
        if self.FrameCounter % self.UpdateRate ~= 0 then return end

        if not self.ESPEnabled then
            for key in pairs(self.TextESPObjects) do self:DestroyTextESP(key) end
            for key, data in pairs(self.BoxESPObjects) do
                self:DestroyBoxESP(data)
                self.BoxESPObjects[key] = nil
            end
            for key, data in pairs(self.HealthBarESPObjects) do
                self:DestroyHealthBarESP(data)
                self.HealthBarESPObjects[key] = nil
            end
            for key, data in pairs(self.SkeletonESPObjects) do
                self:DestroySkeletonESP(data)
                self.SkeletonESPObjects[key] = nil
            end
            return
        end

        local entities = self:GetSortedEntities()
        local activeKeys = {}

        for _, entityData in ipairs(entities) do
            local entity = entityData.Entity
            local key = entityData.SourceName .. "_" .. entity.Name
            activeKeys[key] = true

            if self.TextESPEnabled then
                if not self.TextESPObjects[key] then
                    self:CreateTextESP(entity, entityData)
                end
            else
                if self.TextESPObjects[key] then self:DestroyTextESP(key) end
            end

            if self.BoxESPEnabled then
                if not self.BoxESPObjects[key] then
                    self.BoxESPObjects[key] = self:CreateBoxESP()
                end
                self:UpdateBoxESP(self.BoxESPObjects[key], entity)
            else
                if self.BoxESPObjects[key] then
                    self:DestroyBoxESP(self.BoxESPObjects[key])
                    self.BoxESPObjects[key] = nil
                end
            end

            if self.HealthBarESPEnabled then
                if not self.HealthBarESPObjects[key] then
                    self.HealthBarESPObjects[key] = self:CreateHealthBarESP()
                end
                local hrp = entity:FindFirstChild("HumanoidRootPart")
                if hrp then
                    local hrpPos, onScreen = self.Camera:WorldToViewportPoint(hrp.Position)
                    if onScreen then
                        local screenWidth, screenHeight = self.Camera.ViewportSize.X, self.Camera.ViewportSize.Y
                        local factor = 1 / (hrpPos.Z * math.tan(math.rad(self.Camera.FieldOfView * 0.5)) * 2) * 100
                        local width, height = math.floor(screenHeight / 20 * factor), math.floor(screenWidth / 30 * factor)
                        local boxPos = Vector2.new(hrpPos.X - width / 2, hrpPos.Y - height / 2)
                        local boxSize = Vector2.new(width, height)
                        self:UpdateHealthBarESP(self.HealthBarESPObjects[key], entity, boxPos, boxSize)
                    end
                end
            else
                if self.HealthBarESPObjects[key] then
                    self:DestroyHealthBarESP(self.HealthBarESPObjects[key])
                    self.HealthBarESPObjects[key] = nil
                end
            end

            if self.SkeletonESPEnabled then
                if not self.SkeletonESPObjects[key] then
                    self.SkeletonESPObjects[key] = self:CreateSkeletonESP()
                end
                self:UpdateSkeletonESP(self.SkeletonESPObjects[key], entity)
            else
                if self.SkeletonESPObjects[key] then
                    self:DestroySkeletonESP(self.SkeletonESPObjects[key])
                    self.SkeletonESPObjects[key] = nil
                end
            end
        end

        for key in pairs(self.TextESPObjects) do
            if not activeKeys[key] then self:DestroyTextESP(key) end
        end
        for key in pairs(self.BoxESPObjects) do
            if not activeKeys[key] then
                self:DestroyBoxESP(self.BoxESPObjects[key])
                self.BoxESPObjects[key] = nil
            end
        end
        for key in pairs(self.HealthBarESPObjects) do
            if not activeKeys[key] then
                self:DestroyHealthBarESP(self.HealthBarESPObjects[key])
                self.HealthBarESPObjects[key] = nil
            end
        end
        for key in pairs(self.SkeletonESPObjects) do
            if not activeKeys[key] then
                self:DestroySkeletonESP(self.SkeletonESPObjects[key])
                self.SkeletonESPObjects[key] = nil
            end
        end

        if self.RainbowEnabled then
            local hue = (os.clock() * self.RainbowSpeed) % 1
            local color = Color3.fromHSV(hue, 1, 1)
            self.BoxColor = color
            self.SkeletonColor = color
            self:UpdateBoxESPConfig()
            self:UpdateSkeletonESPConfig()
        end
    end)
end

function ESP:Stop()
    if self.ESPLoopConnection then
        self.ESPLoopConnection:Disconnect()
        self.ESPLoopConnection = nil
    end
    for key in pairs(self.TextESPObjects) do self:DestroyTextESP(key) end
    for key, data in pairs(self.BoxESPObjects) do
        self:DestroyBoxESP(data)
    end
    self.BoxESPObjects = {}
    for key, data in pairs(self.HealthBarESPObjects) do
        self:DestroyHealthBarESP(data)
    end
    self.HealthBarESPObjects = {}
    for key, data in pairs(self.SkeletonESPObjects) do
        self:DestroySkeletonESP(data)
    end
    self.SkeletonESPObjects = {}
end

function ESP:SetEnabled(state)
    self.ESPEnabled = state
    if state then self:Start() else self:Stop() end
end

function ESP:AddTargetSource(name, getEntitiesFunc, isPlayer, startEnabled)
    self.TargetSources[name] = {
        Enabled = startEnabled or false,
        GetEntities = getEntitiesFunc,
        IsPlayer = isPlayer or false
    }
end

function ESP:Destroy()
    self:Stop()
end

return ESP
