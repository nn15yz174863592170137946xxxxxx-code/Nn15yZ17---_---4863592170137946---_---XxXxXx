local CombatGroup = Tabs.Main:AddRightGroupbox("Combat","swords")
CombatGroup:AddLabel("Works while blocking", true)
CombatGroup:AddToggle("FastAutoHit",{
    Text = "Fast Auto Hit",
    Default = false,
    Callback = function(v)
        fastAutoHitEnabled = v
        if v then
            meleeConnection = RunService.Heartbeat:Connect(function()
                local char = LocalPlayer.Character
                if not char then return end
                local root = char:FindFirstChild("HumanoidRootPart")
                if not root then return end

                local tool = char:FindFirstChildOfClass("Tool")
                if not tool then return end
                local remote = tool:FindFirstChild("Remotes")
                if remote then remote = remote:FindFirstChild("OnHit") end
                if not remote then return end

                for _, plr in ipairs(Players:GetPlayers()) do
                    if plr == LocalPlayer then continue end
                    if table.find(WhitelistPlayers, plr.Name) then continue end
                    local otherChar = plr.Character
                    if not otherChar then continue end
                    local otherRoot = otherChar:FindFirstChild("HumanoidRootPart")
                    if not otherRoot then continue end
                    local humanoid = otherChar:FindFirstChildOfClass("Humanoid")
                    if not humanoid or humanoid.Health <= 0 then continue end
                    local dist = (otherRoot.Position - root.Position).Magnitude
                    if dist <= 20 then
                        remote:FireServer(humanoid, "M2")
                    end
                end

                local npcsFolder = workspace:FindFirstChild("NPCs")
                if npcsFolder then
                    for _, model in ipairs(npcsFolder:GetDescendants()) do
                        if model:IsA("Model") then
                            local humanoid = model:FindFirstChildOfClass("Humanoid")
                            if humanoid and humanoid.Health > 0 then
                                local npcRoot = model:FindFirstChild("HumanoidRootPart")
                                if npcRoot then
                                    local dist = (npcRoot.Position - root.Position).Magnitude
                                    if dist <= 20 then
                                        remote:FireServer(humanoid, "M2")
                                    end
                                end
                            end
                        end
                    end
                end
            end)
        else
            if meleeConnection then
                meleeConnection:Disconnect()
                meleeConnection = nil
            end
        end
    end
})

